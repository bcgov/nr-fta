# ===========================================
# FSP Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
VITE_APP_NAME=FSPTS
VITE_ZONE=dev

# Base Path (for deployments behind proxy, e.g., /pub/fsp)
# Leave empty for local development
VITE_BASE_PATH=

# AWS Cognito Configuration
VITE_USER_POOLS_ID=
VITE_USER_POOLS_WEB_CLIENT_ID=

# Redirect URLs
VITE_REDIRECT_SIGN_OUT=http://localhost:3000

# Browser-facing API base path. Same-origin in production (Caddy reverse-
# proxies /api/* to the backend Service). In local dev Vite's proxy
# (vite.config.ts) forwards /api → http://localhost:8080. Leave as /api.
VITE_API_BASE_URL=/api

# Public FOM site base — the "Associated FOMs" links open
# <base>/public/projects?id=<id>#details in a new tab. Set to the same host
# the backend's FOM_API_URL points at so the ids resolve:
#   Test:  https://fom-test.apps.silver.devops.gov.bc.ca
#   Prod:  https://fom.nrs.gov.bc.ca
# Empty falls back to the prod host.
VITE_FOM_PUBLIC_URL=

# Node Environment
NODE_ENV=development

# Development Server (optional)
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
