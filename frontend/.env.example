# ===========================================
# FTA Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
VITE_APP_NAME=Forest Tenure Administration
VITE_ZONE=dev

# Base Path (for deployments behind proxy, e.g., /pub/fta)
# Leave empty for local development
VITE_BASE_PATH=

# BC Gov SSO (Keycloak) Configuration
#   VITE_KEYCLOAK_URL       — the realm's issuer URI (oidc-client-ts `authority`).
#                             It discovers every endpoint from here, so no
#                             per-endpoint variables are needed.
#                               dev:  https://dev.loginproxy.gov.bc.ca/auth/realms/standard
#                               test: https://test.loginproxy.gov.bc.ca/auth/realms/standard
#                               prod: https://loginproxy.gov.bc.ca/auth/realms/standard
#   VITE_KEYCLOAK_CLIENT_ID — the CSS integration's client id. The backend
#                             checks it as the token's `azp`, so the two must
#                             name the same client.
#
# The sign-in redirect URI is <origin><base path>/authCallback and the
# post-logout URI is <origin><base path> — both must be registered on the CSS
# integration. Neither is configured here; they're derived from the runtime
# origin so one image works across PR previews / TEST / PROD.
VITE_KEYCLOAK_URL=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_KEYCLOAK_CLIENT_ID=

# Browser-facing API base path. Same-origin in production (Caddy reverse-
# proxies /api/* to the backend Service). In local dev Vite's proxy
# (vite.config.ts) forwards /api → http://localhost:8080. Leave as /api.
VITE_API_BASE_URL=/api

# Node Environment
NODE_ENV=development

# Development Server (optional)
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
# Where the dev server proxies /api/* — the backend's SERVER_PORT.
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
