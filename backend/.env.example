# ===========================================
# FTA Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# Recommended to set sensitive values directly in the terminal environment for security
# Also i have seen these work better if set directly in terminal environment for spring boot apps

# Server Configuration
# Use 8080 locally: Vite's dev server owns 3000 and proxies /api there
# (frontend/vite.config.ts, VITE_DEV_BACKEND_TARGET). OpenShift also sets 8080.
# Note that application.yml still *defaults* to 3000 when SERVER_PORT is unset,
# so leaving this blank will collide with Vite.
SERVER_PORT=8080

# Spring Profiles (oracle for Oracle DB connection)
SPRING_PROFILES_ACTIVE=oracle

# BC Gov SSO (Keycloak) Configuration
#   KEYCLOAK_ISSUER_URI — the standard realm's issuer URI. The JWKS URI is
#                         derived from it as <issuer>/protocol/openid-connect/certs
#                         (Keycloak's path, not Cognito's /.well-known/jwks.json).
#                           dev:  https://dev.loginproxy.gov.bc.ca/auth/realms/standard
#                           test: https://test.loginproxy.gov.bc.ca/auth/realms/standard
#                           prod: https://loginproxy.gov.bc.ca/auth/realms/standard
#   KEYCLOAK_CLIENT_ID  — the CSS integration's client id, checked as the token's
#                         `azp`. Must equal the frontend's VITE_KEYCLOAK_CLIENT_ID.
#                         The standard realm is shared, so this is what proves a
#                         token was minted for FTA and not for some other app.
KEYCLOAK_ISSUER_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
KEYCLOAK_CLIENT_ID=

# Database Configuration
# BC Gov shared Oracle over TCPS (TLS). The listener on silver exposes only
# port 1543 and requires the full Oracle Net Connect Descriptor — see
# application-oracle.yml. The truststore is written to /cert/jssecacerts by the
# init container in the cluster; for local dev, copy it out of a running pod
# and point TRUSTSTORE_PATH at it.
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
TRUSTSTORE_PATH=
KEYSTORE_SECRET=

# Logging — per-category levels, all optional (default INFO).
# Spring's relaxed binding maps these onto the dot.case keys in application.yml.
APP_LOG_LEVEL=INFO
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
# ORACLE_JDBC_LOG_LEVEL=INFO
