<?xml version="1.0" encoding="UTF-8"?>
<!--
  FTA402 Registered Timber Mark Certificate — ported from the legacy Jasper Server report
  (fta-archive: JCRS/FTA/Reports/FTA/FTA402-PrivateMark). Changes from legacy:
   - no query: the backend supplies the rows (MarkCertificateReport ports FTAR402P's SELECT);
   - signatures: legacy chose one of 12 named officials' scanned signatures, names and titles
     by the activating user's IDIR, hard-coded here. They now come in as parameters
     (SIGNATURE, SIGNATORY_NAME, SIGNATORY_TITLE) from CertificateSignatories, which reads
     them from a mounted folder, never from git. With no signatory set up, a blank signature
     line prints over "Registrar of Timber Marks";
   - images from the classpath (under_mark converted from BMP to PNG);
   - Arial is the registered "Arial" family (fonts/arial.xml: Liberation Sans, metric-compatible
     with Arial).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FTA402_PrivateMark" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="448fdae2-358a-4118-8192-d75a3dbd5ee8">
