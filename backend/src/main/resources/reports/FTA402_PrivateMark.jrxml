	<variable name="v_reference" class="java.lang.String">
		<variableExpression><![CDATA[($F{map_reference_id}).substring(0,2) + "/"
+ ($F{map_reference_id}).substring(2,5) + "/"
+ (($F{map_reference_id}).length() > 5 ? ($F{map_reference_id}).substring(5,6) : "")]]></variableExpression>
	</variable>
	<variable name="tm_1" class="java.lang.String">
		<variableExpression><![CDATA[$F{timber_mark}.substring( 0,1 )]]></variableExpression>
	</variable>
	<variable name="tm_2" class="java.lang.String">
		<variableExpression><![CDATA[$F{timber_mark}.substring( 1,2 )]]></variableExpression>
	</variable>
	<variable name="tm_3" class="java.lang.String">
		<variableExpression><![CDATA[($F{timber_mark}.length() > 2 ? $F{timber_mark}.substring( 2,3 ) : "" )]]></variableExpression>
	</variable>
	<variable name="tm_4" class="java.lang.String">
		<variableExpression><![CDATA[($F{timber_mark}.length() > 3 ? $F{timber_mark}.substring( 3,4 ) : "" )]]></variableExpression>
	</variable>
	<variable name="tm_5" class="java.lang.String">
		<variableExpression><![CDATA[($F{timber_mark}.length() > 4 ? $F{timber_mark}.substring( 4,5 ) : "" )]]></variableExpression>
	</variable>
	<variable name="tm_6" class="java.lang.String">
		<variableExpression><![CDATA[($F{timber_mark}.length() > 5 ? $F{timber_mark}.substring( 5,6 ) : "" )]]></variableExpression>
	</variable>
	<variable name="v_first_line_length" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{timber_mark}.substring( $F{timber_mark}.length() - 1, $F{timber_mark}.length() ).equals("'")
?   (   3 <= $F{timber_mark}.length() && $F{timber_mark}.length() <= 5
  ?   $F{timber_mark}.length() - 1
  :   (   $F{timber_mark}.length() == 6
          ?   3
          :   $F{timber_mark}.length()
      )
    )
:   (   2 <= $F{timber_mark}.length() && $F{timber_mark}.length() <= 4
        ?   $F{timber_mark}.length()
        :   $F{timber_mark}.length() - 3
    )]]></variableExpression>
	</variable>
