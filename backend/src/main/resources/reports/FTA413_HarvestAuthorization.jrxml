<?xml version="1.0" encoding="UTF-8"?>
<!--
  FTA413 Harvest Authorization letter (Fort St. John), legacy FTA902's "Letter" button.

  Legacy was a Crystal report (fta-archive: fta/source/crystal-reports/application/
  FTA413-HarvestAuthorization.rpt) fed by THE.FTARPT_413 and, for its "Block List" subreport,
  THE.FTARPT_413_CUT_BLOCKS. The .rpt's layout streams are encrypted Crystal binary that cannot
  be read without Crystal Reports, so what is here is only what could be recovered:
   - the letterhead image, extracted from the .rpt's embedded bitmap (images/fta413_logo.png);
   - every field FTARPT_413 selects, and the block list;
   - US Letter, one letter per FTARPT_413 row.
  The letter's wording, its field captions and its signature block are NOT in this file: they
  live only in the encrypted .rpt. The captions below name the fields and nothing more.
  The backend supplies the rows (HarvestAuthorizationLetterReport ports the two SELECTs).
  Arial is the registered "Arial" family (fonts/arial.xml: Liberation Sans).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FTA413_HarvestAuthorization" pageWidth="612" pageHeight="792" whenNoDataType="NoPages" columnWidth="540" leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36" uuid="9d1f4a13-6c2e-4b7a-8f41-3e5d7c9a0413">
	<!-- Anything without its own font is Arial too, not Jasper's unembedded default. -->
	<style name="Default" isDefault="true" fontName="Arial" fontSize="10"/>
	<style name="Caption" fontName="Arial" fontSize="10" isBold="true"/>
	<parameter name="P_HVA_SKEY" class="java.lang.String" isForPrompting="false"/>
	<parameter name="P_USERID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="BLOCKS" class="java.util.List" isForPrompting="false"/>
	<parameter name="BLOCK_SUBREPORT" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<field name="forest_file_id" class="java.lang.String"/>
	<field name="harvesting_authority_id" class="java.lang.String"/>
	<field name="issue_date" class="java.lang.String"/>
	<field name="expiry_date" class="java.lang.String"/>
	<field name="client_name" class="java.lang.String"/>
	<field name="address_1" class="java.lang.String"/>
	<field name="city" class="java.lang.String"/>
	<field name="province" class="java.lang.String"/>
	<field name="country" class="java.lang.String"/>
	<field name="postal_code" class="java.lang.String"/>
	<field name="submission_date" class="java.lang.String"/>
	<field name="serverid" class="java.lang.String"/>
	<detail>
		<band height="300" splitType="Stretch">
			<!-- Each FTARPT_413 row is a letter of its own. -->
			<break>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e01" x="0" y="0" width="540" height="1">
					<printWhenExpression><![CDATA[$V{REPORT_COUNT} > 1]]></printWhenExpression>
				</reportElement>
			</break>
			<image scaleImage="RetainShape">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e02" x="0" y="1" width="158" height="45"/>
				<imageExpression><![CDATA["reports/images/fta413_logo.png"]]></imageExpression>
			</image>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e03" x="0" y="70" width="300" height="14"/>
				<textFieldExpression><![CDATA[$F{client_name}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e04" x="0" y="84" width="300" height="14"/>
				<textFieldExpression><![CDATA[$F{address_1}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e05" x="0" y="98" width="300" height="14"/>
				<textFieldExpression><![CDATA[($F{city} == null ? "" : $F{city}) + ($F{province} == null ? "" : "  " + $F{province})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e06" x="0" y="112" width="300" height="14"/>
				<textFieldExpression><![CDATA[($F{country} == null ? "" : $F{country}) + ($F{postal_code} == null ? "" : "  " + $F{postal_code})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e07" style="Caption" x="0" y="150" width="140" height="14"/>
				<text><![CDATA[Forest File ID:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e08" x="140" y="150" width="200" height="14"/>
				<textFieldExpression><![CDATA[$F{forest_file_id}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e09" style="Caption" x="0" y="164" width="140" height="14"/>
				<text><![CDATA[HVA ID:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e10" x="140" y="164" width="200" height="14"/>
				<textFieldExpression><![CDATA[$F{harvesting_authority_id}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e11" style="Caption" x="0" y="178" width="140" height="14"/>
				<text><![CDATA[Submission Date:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e12" x="140" y="178" width="200" height="14"/>
				<textFieldExpression><![CDATA[$F{submission_date}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e13" style="Caption" x="0" y="192" width="140" height="14"/>
				<text><![CDATA[Issue Date:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e14" x="140" y="192" width="200" height="14"/>
				<textFieldExpression><![CDATA[$F{issue_date}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e15" style="Caption" x="0" y="206" width="140" height="14"/>
				<text><![CDATA[Expiry Date:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e16" x="140" y="206" width="200" height="14"/>
				<textFieldExpression><![CDATA[$F{expiry_date}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e17" style="Caption" x="0" y="234" width="140" height="14"/>
				<text><![CDATA[Cut Blocks:]]></text>
			</staticText>
			<subreport>
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e18" x="140" y="234" width="200" height="14"/>
				<!-- A fresh source per letter: a JRDataSource is spent once read. -->
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($P{BLOCKS})]]></dataSourceExpression>
				<subreportExpression><![CDATA[$P{BLOCK_SUBREPORT}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<pageFooter>
		<band height="14" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement uuid="1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e19" x="0" y="0" width="200" height="14"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{serverid}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
