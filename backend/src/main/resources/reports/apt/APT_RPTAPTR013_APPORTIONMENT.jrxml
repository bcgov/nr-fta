<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR013_APPORTIONMENT" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="49c4e6b1-9634-448f-a3b8-95eb651f022a">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<parameter name="p_in_region_org_unit_no" class="java.math.BigDecimal"/>
	<!-- Was THE.APT_RPTAPTR013_APPORTIONMENT; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- The procedure fetched the region's grand totals into variables first (same FROM/WHERE as the
-- result), defaulted them to 0, then divided each row by them; here the grand totals are the
-- analytic sum of the grouped sums over the same rows.
WITH
     munv AS ( -- APT_MGMT_UNIT_NAMES_V
       SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                   AS apt_mgmt_unit_st,
              clt.code_argument     AS mgmt_unit_number,
              clt.expanded_result   AS mgmt_unit_name
         FROM the.code_list_table clt
        WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
       UNION
       SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
              NULL,
              clt2.expanded_result
         FROM the.code_list_table clt2
        WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
          AND clt2.code_argument = 'Z'),
     aprv AS ( -- APT_PART_RPT_V
       SELECT clt.code_argument   AS part_type_cd,
              clt.expanded_result AS part_type_desc
         FROM the.code_list_table clt,
              the.code_subset_tbl cst
        WHERE cst.code_subset_name = 'APT_PART_RPT_ST'
          AND clt.column_name = cst.column_name
          AND clt.code_argument = cst.code_argument)
SELECT mu.org_unit_no,
       munv.mgmt_unit_name                   AS apport_name,
       muh.apportionment_determination_dt    AS apport_det_dt,
       muh.apportionment_effective_date      AS apport_eff_dt,
       SUM(papt.allowable_annual_cut)        AS sum_apport_aac_m3,
       DECODE(NVL(SUM(SUM(papt.allowable_annual_cut)) OVER (), 0), 0, 0,
              SUM(papt.allowable_annual_cut) / SUM(SUM(papt.allowable_annual_cut)) OVER () * 100)
                                             AS sum_apport_aac_m3_percent,
       SUM(papt.allowable_annual_cut_ha)     AS sum_apport_aac_ha,
       DECODE(NVL(SUM(SUM(papt.allowable_annual_cut_ha)) OVER (), 0), 0, 0,
              SUM(papt.allowable_annual_cut_ha) / SUM(SUM(papt.allowable_annual_cut_ha)) OVER () * 100)
                                             AS sum_apport_aac_ha_percent
  FROM the.apt_part_apportionments papt,
       the.apt_partitions          part,
       aprv,
       munv,
       the.apt_management_units    mu,
       the.apt_mgmt_unit_history   muh
 WHERE mu.org_unit_no = $P{p_in_region_org_unit_no}
   AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
   AND mu.apt_mgmt_unit_st = 'U'
   AND mu.mgmt_unit_number = munv.mgmt_unit_number
   AND mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st
   AND mu.id = muh.mu_id
   AND muh.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
   AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
       || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
       (SELECT MAX(TO_CHAR(muh2.effective_date, 'YYYYMMDD')
                   || TO_CHAR(NVL(muh2.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
          FROM the.apt_mgmt_unit_history muh2
         WHERE muh2.mu_id = mu.id
           AND muh2.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
           AND muh2.apportionment_effective_date <= CAST($P{p_in_rpt_date} AS DATE))
   AND muh.id = part.muh_id
   AND part.apt_partition_st = aprv.part_type_cd
   AND papt.part_id = part.id
 GROUP BY munv.mgmt_unit_name,
          mu.org_unit_no,
          muh.apportionment_determination_dt,
          muh.apportionment_effective_date]]>
	</queryString>
	<field name="ORG_UNIT_NO" class="java.math.BigDecimal"/>
	<field name="APPORT_NAME" class="java.lang.String"/>
	<field name="APPORT_DET_DT" class="java.sql.Timestamp"/>
	<field name="APPORT_EFF_DT" class="java.sql.Timestamp"/>
	<field name="SUM_APPORT_AAC_M3" class="java.math.BigDecimal"/>
	<field name="SUM_APPORT_AAC_M3_PERCENT" class="java.math.BigDecimal"/>
	<field name="SUM_APPORT_AAC_HA" class="java.math.BigDecimal"/>
	<field name="SUM_APPORT_AAC_HA_PERCENT" class="java.math.BigDecimal"/>
	<variable name="sum_of_SUM_APPORT_AAC_M3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_APPORT_AAC_M3}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_APPORT_AAC_M3_PERCENT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_APPORT_AAC_M3_PERCENT}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_APPORT_AAC_HA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_APPORT_AAC_HA}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_APPORT_AAC_HA_PERCENT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_APPORT_AAC_HA_PERCENT}]]></variableExpression>
	</variable>
	<group name="ORG_UNIT_NO">
		<groupExpression><![CDATA[$F{ORG_UNIT_NO}]]></groupExpression>
	</group>
