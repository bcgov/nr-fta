<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR032_COMMITMENTS" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="8cfdcf40-45ae-4e9a-89bc-9008dbad10f1">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR032_COMMITMENTS; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[SELECT 'TSA' mgmt_unit_code,
       acat.sort_order sort_order,
       foa_view.expanded_result foa_description,
       SUM(commj.allowable_annual_cut) comm_aac,
       COUNT(DISTINCT pfu.forest_file_id) lic_count
  FROM the.prov_forest_use              pfu,
       the.apt_management_units         mu,
       the.tenure_term                  tt,
       the.apt_licences                 lic,
       the.apt_apportionment_categories acat,
       the.apt_commitments_jn           commj,
       (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)              foa_view
 WHERE pfu.file_status_st IN ('HI', 'HS') AND
       pfu.mgmt_unit_type = mu.apt_mgmt_unit_st AND
       pfu.mgmt_unit_id = mu.mgmt_unit_number AND
       mu.mgmt_unit_status_st = 'ACT' AND
       pfu.forest_file_id = tt.forest_file_id AND
       (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
               to_date('9999-12-31',
                       'YYYY-MM-DD'),
               tt.initial_expiry_dt,
               tt.current_expiry_dt) > CAST($P{p_in_rpt_date} AS DATE)) AND
       pfu.forest_file_id = lic.forest_file_id AND
       lic.forest_file_id = commj.forest_file_id AND
       acat.apt_foa_st = lic.apt_foa_st AND
       acat.apt_mgmt_unit_st = 'U' AND pfu.mgmt_unit_type = 'U' AND
       commj.effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
       nvl(commj.expiry_date,
           to_date('2999-12-31',
                   'YYYY-MM-DD')) > CAST($P{p_in_rpt_date} AS DATE) AND
       commj.jn_datetime =
       (SELECT MAX(jn_datetime)
          FROM (SELECT ucj.jn_datetime, ucj.id, ucj.forest_file_id, ucj.apt_partition_st, ucj.commit_type_st, ucj.allowable_annual_cut, ucj.include_in_lic_aac_ind, ucj.determination_date, ucj.effective_date, ucj.expiry_date, ucj.papt_id FROM the.apt_commitments_jn ucj WHERE ucj.id NOT IN (SELECT ucj_del.id FROM the.apt_commitments_jn ucj_del WHERE ucj_del.jn_operation = 'DEL'))
         WHERE id = commj.id) AND
       commj.include_in_lic_aac_ind = 'Y' AND
       acat.apt_foa_st = foa_view.code_argument AND
           acat.apt_mgmt_unit_st = foa_view.APT_MGMT_UNIT_ST
 GROUP BY 'TSA',
          foa_view.expanded_result,
          acat.sort_order
UNION
    -- This subquery selects the TSA row "Pulpwood Agreement TSL", and perhaps
    -- others in another environment.
    SELECT 'TSA' mgmt_unit_code,
           acat.sort_order sort_order,
           foa_view.expanded_result foa_description,
           SUM(commj.allowable_annual_cut) comm_aac,
           COUNT(DISTINCT pfu.forest_file_id) lic_count
      FROM the.prov_forest_use              pfu,
           the.tenure_term                  tt,
           the.apt_licences                 lic,
           the.apt_apportionment_categories acat,
           the.apt_commitments_jn           commj,
           (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)              foa_view
     WHERE pfu.file_status_st IN ('HI', 'HS') AND
           pfu.mgmt_unit_type = 'Z' AND
           pfu.forest_file_id = tt.forest_file_id AND
           (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                   to_date('9999-12-31',
                           'YYYY-MM-DD'),
                   tt.initial_expiry_dt,
                   tt.current_expiry_dt) > CAST($P{p_in_rpt_date} AS DATE)) AND
           pfu.forest_file_id = lic.forest_file_id AND
           lic.forest_file_id = commj.forest_file_id AND
           acat.apt_foa_st = lic.apt_foa_st AND
           acat.apt_mgmt_unit_st = 'U' AND pfu.mgmt_unit_type = 'Z' AND
           commj.effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
           nvl(commj.expiry_date,
               to_date('2999-12-31',
                       'YYYY-MM-DD')) > CAST($P{p_in_rpt_date} AS DATE) AND
           commj.jn_datetime =
           (SELECT MAX(jn_datetime)
              FROM (SELECT ucj.jn_datetime, ucj.id, ucj.forest_file_id, ucj.apt_partition_st, ucj.commit_type_st, ucj.allowable_annual_cut, ucj.include_in_lic_aac_ind, ucj.determination_date, ucj.effective_date, ucj.expiry_date, ucj.papt_id FROM the.apt_commitments_jn ucj WHERE ucj.id NOT IN (SELECT ucj_del.id FROM the.apt_commitments_jn ucj_del WHERE ucj_del.jn_operation = 'DEL'))
             WHERE id = commj.id) AND
           commj.include_in_lic_aac_ind = 'Y' AND
           acat.apt_foa_st = foa_view.code_argument AND
           acat.apt_mgmt_unit_st = foa_view.APT_MGMT_UNIT_ST
     GROUP BY 'TSA',
              acat.sort_order,
              foa_view.expanded_result
    UNION
        -- This subquery selects the TFL rows.
        SELECT decode(pfu.mgmt_unit_type,
                      'T',
                      'TFL')                   mgmt_unit_code,
               acat.sort_order          sort_order,
               foa_view.expanded_result foa_description,
               SUM(commj.allowable_annual_cut)                      tw_comm_aac,
               COUNT(DISTINCT pfu.forest_file_id)                    lic_count_tw
          FROM the.prov_forest_use      pfu,
               the.apt_management_units mu,
               the.tenure_term tt,
               the.apt_licences                 lic,
               the.apt_apportionment_categories acat,
               the.apt_commitments_jn           commj,
               (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)              foa_view
         WHERE pfu.file_status_st IN ('HI', 'HS') AND
               pfu.mgmt_unit_type = mu.apt_mgmt_unit_st AND
               pfu.mgmt_unit_id = mu.mgmt_unit_number AND
               mu.mgmt_unit_status_st = 'ACT' AND
               pfu.forest_file_id = tt.forest_file_id AND
               (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                       to_date('9999-12-31',
                               'YYYY-MM-DD'),
                       tt.initial_expiry_dt,
                       tt.current_expiry_dt) > CAST($P{p_in_rpt_date} AS DATE)) AND
               pfu.mgmt_unit_type IN ('T') --, 'F') CR10
               AND pfu.forest_file_id = lic.forest_file_id AND
               lic.forest_file_id = commj.forest_file_id AND
               acat.apt_foa_st = lic.apt_foa_st AND
               acat.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
               commj.effective_date(+) <= CAST($P{p_in_rpt_date} AS DATE) AND
               nvl(commj.expiry_date,
                   to_date('2999-12-31',
                           'YYYY-MM-DD')) > CAST($P{p_in_rpt_date} AS DATE) AND
               nvl(commj.jn_datetime,
                   to_date('18001231',
                           'YYYYMMDD')) =
               (SELECT nvl(MAX(jn_datetime),
                           to_date('18001231',
                                   'YYYYMMDD'))
                  FROM (SELECT ucj.jn_datetime, ucj.id, ucj.forest_file_id, ucj.apt_partition_st, ucj.commit_type_st, ucj.allowable_annual_cut, ucj.include_in_lic_aac_ind, ucj.determination_date, ucj.effective_date, ucj.expiry_date, ucj.papt_id FROM the.apt_commitments_jn ucj WHERE ucj.id NOT IN (SELECT ucj_del.id FROM the.apt_commitments_jn ucj_del WHERE ucj_del.jn_operation = 'DEL'))
                 WHERE id = commj.id) AND
               commj.include_in_lic_aac_ind = 'Y' AND
               foa_view.code_argument = acat.apt_foa_st AND
           acat.apt_mgmt_unit_st = foa_view.APT_MGMT_UNIT_ST
         GROUP BY decode(pfu.mgmt_unit_type,
                         'T',
                         'TFL'), -- 'F', 'WL') CR10
                  foa_view.expanded_result,
                  acat.sort_order]]>
	</queryString>
	<field name="MGMT_UNIT_CODE" class="java.lang.String"/>
	<field name="SORT_ORDER" class="java.math.BigDecimal"/>
	<field name="FOA_DESCRIPTION" class="java.lang.String"/>
	<field name="COMM_AAC" class="java.math.BigDecimal"/>
	<field name="LIC_COUNT" class="java.math.BigDecimal"/>
	<variable name="mgmt_unit_total_COMM_AAC" class="java.math.BigDecimal" resetType="Group" resetGroup="MGMT_UNIT_CODE" calculation="Sum">
		<variableExpression><![CDATA[$F{COMM_AAC}]]></variableExpression>
	</variable>
	<variable name="mgmt_unit_total_LIC_COUNT" class="java.math.BigDecimal" resetType="Group" resetGroup="MGMT_UNIT_CODE" calculation="Sum">
		<variableExpression><![CDATA[$F{LIC_COUNT}]]></variableExpression>
	</variable>
	<variable name="grand_total_COMM_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{COMM_AAC}]]></variableExpression>
	</variable>
	<variable name="grand_total_LIC_COUNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LIC_COUNT}]]></variableExpression>
	</variable>
