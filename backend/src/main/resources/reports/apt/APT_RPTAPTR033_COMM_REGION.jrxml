<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR033_COMM_REGION" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c3bffe88-8a46-44cc-a89c-b06600dc99ae">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR033_COMM_REGION; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[SELECT ou.org_unit_code comm_org_unit_code,
       ou.org_unit_no comm_ou_no,
       ou.org_unit_name
  FROM the.org_unit ou
 WHERE ou.org_unit_code LIKE 'R__' AND
       effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND expiry_date >= CAST($P{p_in_rpt_date} AS DATE)]]>
	</queryString>
	<field name="COMM_ORG_UNIT_CODE" class="java.lang.String"/>
	<field name="COMM_OU_NO" class="java.math.BigDecimal"/>
	<field name="ORG_UNIT_NAME" class="java.lang.String"/>
