<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR041_JOINT_LICS" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="19c6be42-02f7-4dbb-98c2-b4ecadc0436a">
	<!-- Was THE.APT_RPTAPTR041_JOINT_LICS; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- APT_RPT_COUNT_LICENCEES is inlined as a scalar subquery: the count of the rows of the licence
-- in APT_LICENCE_CLIENTS_V (licence_clients below).
WITH munv AS (
    -- APT_MGMT_UNIT_NAMES_V
    SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                AS apt_mgmt_unit_st,
           clt.code_argument     AS mgmt_unit_number,
           clt.expanded_result   AS mgmt_unit_name
      FROM the.code_list_table clt
     WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
    UNION
    SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
           NULL,
           clt2.expanded_result
      FROM the.code_list_table clt2
     WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
       AND clt2.code_argument = 'Z'
),
licence_clients AS (
    -- APT_LICENCE_CLIENTS_V (V_CLIENT_PUBLIC is FOREST_CLIENT)
    SELECT DISTINCT lic.forest_file_id,
           DECODE(vcp.client_type_code, 'I',
                  vcp.client_name || CHR(10) || '     ,' || vcp.legal_first_name,
                  vcp.client_name) AS client_name,
           fcl.file_client_type,
           vcp.client_number
      FROM the.apt_licences lic,
           the.for_client_link fcl,
           the.forest_client vcp
     WHERE lic.forest_file_id = fcl.forest_file_id
       AND vcp.client_number = fcl.client_number
       AND fcl.file_client_type IN ('A', 'B')
),
licensee_names AS (
    -- APT_RPT_CAT_LICENSEE_NAME: the client names of the licence in FILE_CLIENT_TYPE order,
    -- joined with '; ', first 80 characters
    SELECT lc.forest_file_id,
           SUBSTR(LISTAGG(lc.client_name, '; ' ON OVERFLOW TRUNCATE '' WITHOUT COUNT)
                    WITHIN GROUP (ORDER BY lc.file_client_type, lc.client_number), 1, 80)
             AS licencee
      FROM licence_clients lc
     GROUP BY lc.forest_file_id
)
/* JOINTLY HELD */
    SELECT DISTINCT lic.forest_file_id forest_file_id_j,
                    ln.licencee licencee,
                    tt.current_expiry_dt expiry_date_j,
                    tt.initial_expiry_dt init_expiry_dt_j,
                    ou.org_unit_code region_code_j,
                    munv.mgmt_unit_name mgmt_unit_name_j,
                    lic.apt_foa_st foa_j,
                    SUM(comm.allowable_annual_cut) sum_aac_j,
                    0 uav_vol_j, -- CR01-03
                    ' ' uav_j -- CR01-03
      FROM the.apt_licences          lic,
           licensee_names          ln,
           the.prov_forest_use       pfu,
           the.tenure_term           tt,
           the.apt_management_units  mu,
           the.org_unit              ou,
           munv munv,
           the.apt_commitments       comm
     WHERE ln.forest_file_id = lic.forest_file_id AND
           ou.org_unit_no = mu.org_unit_no AND
           munv.mgmt_unit_number = mu.mgmt_unit_number AND
           munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
           mu.apt_mgmt_unit_st IN ('T', 'U') AND
           mu.mgmt_unit_status_st = 'ACT' -- CR7
           AND mu.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
           mu.mgmt_unit_number = pfu.mgmt_unit_id
          -- AND  PFU.FILE_STATUS_ST <> 'HC'          -- CR7
           AND pfu.file_status_st IN ('HI', 'HS') -- CR7
           AND pfu.forest_file_id = tt.forest_file_id --CR13
           AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                       to_date('9999-12-31','YYYY-MM-DD'), --CR13
                       tt.initial_expiry_dt,
                       tt.current_expiry_dt) > SYSDATE) --CR13
           AND lic.forest_file_id = pfu.forest_file_id AND
           lic.forest_file_id = comm.forest_file_id AND
           SYSDATE BETWEEN comm.effective_date AND
           nvl(comm.expiry_date,
               to_date('299912312359',
                       'yyyymmddhh24mi')) AND
           comm.include_in_lic_aac_ind = 'Y' /*AND
                                       &p_is_jointly_held*/
           AND 1 < (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
     GROUP BY lic.forest_file_id, ln.licencee,
              tt.current_expiry_dt,
              tt.initial_expiry_dt,
              ou.org_unit_code,
              munv.mgmt_unit_name,
              lic.apt_foa_st
    UNION
    /*  mgmt_unit_type = 'Z' */
        SELECT DISTINCT lic.forest_file_id forest_file_id_j,
                        ln.licencee licencee,
                        tt.current_expiry_dt expiry_date_j,
                        tt.initial_expiry_dt init_expiry_dt_j,
                        ou.org_unit_code region_code_j,
                        munv.mgmt_unit_name mgmt_unit_name_j,
                        lic.apt_foa_st foa_j,
                        SUM(comm.allowable_annual_cut) sum_aac_j,
                        0 uav_vol_j -- CR01-03
                       ,
                        ' ' uav_j -- CR01-03
          FROM the.apt_licences            lic,
               licensee_names            ln,
               the.prov_forest_use         pfu,
               the.tenure_term             tt,
               the.apt_partitions          part,
               the.apt_part_apportionments papt,
               the.apt_mgmt_unit_history   muh,
               the.apt_management_units    mu,
               the.org_unit                ou,
               munv   munv,
               the.apt_commitments         comm
         WHERE ln.forest_file_id = lic.forest_file_id AND
               pfu.mgmt_unit_type = 'Z' AND
               pfu.forest_file_id = lic.forest_file_id AND
               pfu.file_status_st IN ('HI', 'HS') -- CR7
               AND lic.forest_file_id = comm.forest_file_id AND
               comm.papt_id = papt.id AND papt.part_id = part.id AND
               part.muh_id = muh.id AND muh.mu_id = mu.id AND
               mu.org_unit_no = ou.org_unit_no AND
               mu.mgmt_unit_number = munv.mgmt_unit_number AND
               mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st AND
               mu.apt_mgmt_unit_st IN ('T', 'U') AND
               mu.mgmt_unit_status_st = 'ACT' -- CR7
              -- AND MU.APT_MGMT_UNIT_ST = PFU.MGMT_UNIT_TYPE
              -- AND MU.MGMT_UNIT_NUMBER = PFU.MGMT_UNIT_ID
               AND pfu.forest_file_id = tt.forest_file_id --CR13
               AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                           to_date('9999-12-31','YYYY-MM-DD'), --CR13
                           tt.initial_expiry_dt,
                           tt.current_expiry_dt) > SYSDATE) --CR13
               AND SYSDATE BETWEEN comm.effective_date AND
               nvl(comm.expiry_date,
                   to_date('299912312359',
                           'yyyymmddhh24mi')) AND
               comm.include_in_lic_aac_ind = 'Y' /*AND &p_is_jointly_held*/
               AND 1 < (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
         GROUP BY lic.forest_file_id, ln.licencee,
                  tt.current_expiry_dt,
                  tt.initial_expiry_dt,
                  ou.org_unit_code,
                  munv.mgmt_unit_name,
                  lic.apt_foa_st
        --order by FOREST_FILE_ID_J
        /* Unapportioned Volume */
        UNION
            SELECT DISTINCT lic.forest_file_id forest_file_id_j,
                            ln.licencee licencee,
                            tt.current_expiry_dt expiry_date_j,
                            tt.initial_expiry_dt init_expiry_dt_j,
                            ou.org_unit_code region_code_j,
                            munv.mgmt_unit_name mgmt_unit_name_j,
                            lic.apt_foa_st foa_j,
                            0 sum_aac_j -- CR01-03
                           ,
                            SUM(comm.allowable_annual_cut) uav_vol_j -- CR01-03
                           ,
                            '#' uav_j -- CR01-03
              FROM the.apt_licences          lic,
                   licensee_names          ln,
                   the.prov_forest_use       pfu,
                   the.tenure_term           tt,
                   the.apt_management_units  mu,
                   the.org_unit              ou,
                   munv munv,
                   the.apt_commitments       comm
             WHERE ln.forest_file_id = lic.forest_file_id AND
                   ou.org_unit_no = mu.org_unit_no AND
                   munv.mgmt_unit_number = mu.mgmt_unit_number AND
                   munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
                   mu.apt_mgmt_unit_st IN ('T', 'U') AND
                   mu.mgmt_unit_status_st = 'ACT' -- CR7
                   AND mu.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
                   mu.mgmt_unit_number = pfu.mgmt_unit_id
                  -- AND  PFU.FILE_STATUS_ST <> 'HC'          -- CR7
                   AND pfu.file_status_st IN ('HI', 'HS') -- CR7
                   AND pfu.forest_file_id = tt.forest_file_id --CR13
                   AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                               to_date('9999-12-31','YYYY-MM-DD'), --CR13
                               tt.initial_expiry_dt,
                               tt.current_expiry_dt) > SYSDATE) --CR13
                   AND lic.forest_file_id = pfu.forest_file_id AND
                   lic.forest_file_id = comm.forest_file_id AND
                   SYSDATE BETWEEN comm.effective_date AND
                   nvl(comm.expiry_date,
                       to_date('299912312359',
                               'yyyymmddhh24mi'))
                  -- and  comm.include_in_lic_aac_ind = 'Y'               -- CR01-03
                   AND comm.include_in_lic_aac_ind = 'N' -- CR01-03
                   AND comm.apt_partition_st = 'UAV' -- CR01-03
                  /*      AND &p_is_jointly_held*/
                   AND 1 < (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
             GROUP BY lic.forest_file_id, ln.licencee,
                      tt.current_expiry_dt,
                      tt.initial_expiry_dt,
                      ou.org_unit_code,
                      munv.mgmt_unit_name,
                      lic.apt_foa_st
            UNION
            /*  mgmt_unit_type = 'Z' */
                SELECT DISTINCT lic.forest_file_id forest_file_id_j,
                                ln.licencee licencee,
                                tt.current_expiry_dt expiry_date_j,
                                tt.initial_expiry_dt init_expiry_dt_j,
                                ou.org_unit_code region_code_j,
                                munv.mgmt_unit_name mgmt_unit_name_j,
                                lic.apt_foa_st foa_j,
                                0 sum_aac_j -- CR01-03
                               ,
                                SUM(comm.allowable_annual_cut) uav_vol_j -- CR01-03
                               ,
                                '#' uav_j -- CR01-03 This char must match the Report
                  FROM the.apt_licences            lic,
                       licensee_names            ln,
                       the.prov_forest_use         pfu,
                       the.tenure_term             tt,
                       the.apt_partitions          part,
                       the.apt_part_apportionments papt,
                       the.apt_mgmt_unit_history   muh,
                       the.apt_management_units    mu,
                       the.org_unit                ou,
                       munv   munv,
                       the.apt_commitments         comm
                 WHERE ln.forest_file_id = lic.forest_file_id AND
                       pfu.mgmt_unit_type = 'Z' AND
                       pfu.forest_file_id = lic.forest_file_id AND
                       pfu.file_status_st IN ('HI', 'HS') -- CR7
                       AND lic.forest_file_id = comm.forest_file_id AND
                       comm.papt_id = papt.id AND
                       papt.part_id = part.id AND part.muh_id = muh.id AND
                       muh.mu_id = mu.id AND
                       mu.org_unit_no = ou.org_unit_no AND
                       mu.mgmt_unit_number = munv.mgmt_unit_number AND
                       mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st AND
                       mu.apt_mgmt_unit_st IN ('T', 'U') AND
                       mu.mgmt_unit_status_st = 'ACT' -- CR7
                      -- AND MU.APT_MGMT_UNIT_ST = PFU.MGMT_UNIT_TYPE
                      -- AND MU.MGMT_UNIT_NUMBER = PFU.MGMT_UNIT_ID
                       AND pfu.forest_file_id = tt.forest_file_id --CR13
                       AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                   to_date('9999-12-31','YYYY-MM-DD'), --CR13
                                   tt.initial_expiry_dt,
                                   tt.current_expiry_dt) > SYSDATE) --CR13
                       AND SYSDATE BETWEEN comm.effective_date AND
                       nvl(comm.expiry_date,
                           to_date('299912312359',
                                   'yyyymmddhh24mi'))
                      -- and  comm.include_in_lic_aac_ind = 'Y'               -- CR01-03
                       AND comm.include_in_lic_aac_ind = 'N' -- CR01-03
                       AND comm.apt_partition_st = 'UAV' -- CR01-03
                      /*      AND &p_is_jointly_held*/
                       AND
                       1 < (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
                 GROUP BY lic.forest_file_id, ln.licencee,
                          tt.current_expiry_dt,
                          tt.initial_expiry_dt,
                          ou.org_unit_code,
                          munv.mgmt_unit_name,
                          lic.apt_foa_st
                 ORDER BY 1]]>
	</queryString>
	<field name="FOREST_FILE_ID_J" class="java.lang.String"/>
	<field name="LICENCEE" class="java.lang.String"/>
	<field name="EXPIRY_DATE_J" class="java.sql.Timestamp"/>
	<field name="INIT_EXPIRY_DT_J" class="java.sql.Timestamp"/>
	<field name="REGION_CODE_J" class="java.lang.String"/>
	<field name="MGMT_UNIT_NAME_J" class="java.lang.String"/>
	<field name="FOA_J" class="java.lang.String"/>
	<field name="SUM_AAC_J" class="java.math.BigDecimal"/>
	<field name="UAV_VOL_J" class="java.math.BigDecimal"/>
	<field name="UAV_J" class="java.lang.String"/>
	<variable name="aac" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( $F{SUM_AAC_J}.intValue() == 0 ? $F{UAV_VOL_J} : $F{SUM_AAC_J} )]]></variableExpression>
	</variable>
	<variable name="expiryDate" class="java.sql.Timestamp">
		<variableExpression><![CDATA[( $F{EXPIRY_DATE_J}.after( $F{INIT_EXPIRY_DT_J} ) ? $F{EXPIRY_DATE_J} : $F{INIT_EXPIRY_DT_J} )]]></variableExpression>
	</variable>
	<variable name="total_aac" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{aac}]]></variableExpression>
	</variable>
