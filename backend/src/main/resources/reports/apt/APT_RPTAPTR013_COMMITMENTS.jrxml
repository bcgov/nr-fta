					<cellContents>
						<textField isStretchWithOverflow="true" pattern="#,##0" isBlankWhenNull="true">
							<reportElement uuid="a843a4ce-5173-4d5a-ab04-9dbf7ecc4fd4" style="Crosstab Data Text" x="0" y="0" width="65" height="11" isRemoveLineWhenBlank="true">
								<printWhenExpression><![CDATA[$V{COMM_VALUEMeasure_FOA_DESCRIPTION_TSA_SORT_ORDER_ALL} != null && $V{COMM_VALUEMeasure_FOA_DESCRIPTION_TSA_SORT_ORDER_ALL}.doubleValue() > 0.0]]></printWhenExpression>
