				<crosstabCell width="50" columnTotalGroup="TSA_SORT_ORDER">
					<cellContents backcolor="#BFE1FF" mode="Opaque">
						<textField isBlankWhenNull="true">
							<reportElement uuid="0d3a9cd1-36d0-44b7-93f6-3833643dc77e" style="Crosstab Data Text" x="0" y="0" width="50" height="25"/>
							<textElement/>
							<textFieldExpression><![CDATA[$V{COMM_VALUEMeasure}]]></textFieldExpression>
						</textField>
					</cellContents>
				</crosstabCell>
				<crosstabCell rowTotalGroup="FOA_SORT_ORDER" columnTotalGroup="TSA_SORT_ORDER">
					<cellContents backcolor="#BFE1FF" mode="Opaque">
