	<detail>
		<band height="162" splitType="Stretch">
			<staticText>
				<reportElement uuid="fd061855-9f5b-4773-8371-b7b3e737f96a" x="0" y="0" width="572" height="158"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<text><![CDATA[NOTES:
* This report includes licences with an AAC in timber supply areas, tree farm licences, and pulpwood agreements with apportioned volume only.
*  Licences are linked to a corporate group or company if the corporate group or company is affiliated with or controls the licence holder, as defined by Section 53 of the Forest Act.
*  INDEPENDENT MEDIUM licences have an AAC greater than or equal to 25,000 m3 and less than 100,000 m3.
*  INDEPENDENT SMALL licences have an AAC less than 25,000 m3.
*  JOINTLY HELD LICENCES are licences held by more than one corporate group or company.
*  TFL26 is held by the Corporation of the District of Mission.
* # Indicates Lump Sum Volumes that originated from a licence under-cut or from under-sold units in the competitive program.]]></text>
			</staticText>
		</band>
