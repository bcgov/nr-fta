				<measure name="SUM_PAPT_AAC_HAMeasure" class="java.math.BigDecimal" calculation="Sum">
					<measureExpression><![CDATA[$F{SUM_PAPT_AAC_HA}]]></measureExpression>
				</measure>
				<crosstabCell width="65" height="11">
					<cellContents>
						<textField isStretchWithOverflow="true" pattern="" isBlankWhenNull="true">
							<reportElement uuid="376976ed-9984-40d7-bcd6-588b3d9b508e" style="Crosstab Data Text" x="0" y="0" width="65" height="11" isRemoveLineWhenBlank="true">
								<printWhenExpression><![CDATA[$V{SUM_PAPT_AAC_HAMeasure_FOA_DESCRIPTION_TSA_MGMT_UNIT_SORT_ORDER_ALL} != null && $V{SUM_PAPT_AAC_HAMeasure_FOA_DESCRIPTION_TSA_MGMT_UNIT_SORT_ORDER_ALL}.doubleValue() > 0.0]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Right" verticalAlignment="Middle">
