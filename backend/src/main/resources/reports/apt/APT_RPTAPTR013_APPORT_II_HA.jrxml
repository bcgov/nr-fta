<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR013_APPORT_II_HA" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="9054e065-3e6e-4c68-bbd6-2d7a214d9f90">
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="p_in_region_org_unit_no" class="java.math.BigDecimal"/>
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<parameter name="p_in_col_start" class="java.lang.Integer"/>
	<parameter name="p_in_col_count" class="java.lang.Integer"/>
	<!-- Was THE.APT_RPTAPTR013_APPORT_II_HA; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- The procedure looped over the column list (c_tsa_list, a UNION, so in sorted order), kept the
-- columns ranked p_in_col_start .. +p_in_col_count-1 (no defaults here) in a comma list, counted
-- the ones after them, returned a single dummy row when the list was empty, and otherwise
-- returned the rows whose column number is a substring of that list (LIKE '%' || n || '%').
-- Here: col_rank numbers the same UNION in the same order, col_window is the kept columns and the
-- LIKE runs against each of them (the numbers contain no comma, so a substring of the list is a
-- substring of one entry). The function and package calls are joined in as grouped CTEs:
-- APT_RPT_APTR013_PART_HA_TOTALS (tsa_ha_total), APTR.REG_PAPT_FOA_AAC_HA (reg_foa, NVL 0), and
-- the percentage grand total q_ha_aftv (sum over the region's FOAs with hectares, foa_ha).
WITH
     munv AS ( -- APT_MGMT_UNIT_NAMES_V
       SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                   AS apt_mgmt_unit_st,
              clt.code_argument     AS mgmt_unit_number,
              clt.expanded_result   AS mgmt_unit_name
         FROM the.code_list_table clt
        WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
       UNION
       SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
              NULL,
              clt2.expanded_result
         FROM the.code_list_table clt2
        WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
          AND clt2.code_argument = 'Z'),
     aprv AS ( -- APT_PART_RPT_V
       SELECT clt.code_argument   AS part_type_cd,
              clt.expanded_result AS part_type_desc
         FROM the.code_list_table clt,
              the.code_subset_tbl cst
        WHERE cst.code_subset_name = 'APT_PART_RPT_ST'
          AND clt.column_name = cst.column_name
          AND clt.code_argument = cst.code_argument),
     aftv AS ( -- APT_FOA_TYPES_V
       SELECT clt.code_argument,
              clt.expanded_result,
              clt.effective_date,
              clt.expiry_date,
              acat.apt_mgmt_unit_st,
              acat.sort_order
         FROM the.code_list_table clt,
              the.code_subset_tbl cst,
              the.apt_apportionment_categories acat
        WHERE cst.code_subset_name = 'APT_FOA_ST'
          AND clt.column_name = cst.column_name
          AND clt.code_argument = cst.code_argument
          AND acat.apt_foa_st = clt.code_argument),
     tsa AS ( -- the region's TSAs on the history row with the latest apportionment effective date
       -- (a window MAX rather than the procedure's correlated MAX subquery, which Oracle rejected
       -- here with ORA-00978 once the CTEs were merged; every filter is per unit, so each unit
       -- keeps all its history rows and the latest date is the same)
       SELECT DISTINCT org_unit_no, mgmt_unit_name, mgmt_unit_number
         FROM (SELECT mu.org_unit_no,
                      munv.mgmt_unit_name,
                      mu.mgmt_unit_number,
                      muh.apportionment_effective_date,
                      MAX(CASE WHEN muh.apportionment_effective_date <= CAST($P{p_in_rpt_date} AS DATE)
                               THEN muh.apportionment_effective_date END)
                        OVER (PARTITION BY muh.mu_id) AS latest_apportionment_date
                 FROM munv,
                      the.apt_management_units  mu,
                      the.apt_mgmt_unit_history muh
                WHERE mu.apt_mgmt_unit_st = 'U'
                  AND mu.id = muh.mu_id
                  AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
                  AND mu.mgmt_unit_number = munv.mgmt_unit_number
                  AND mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st
                  AND mu.org_unit_no = $P{p_in_region_org_unit_no})
        WHERE apportionment_effective_date = latest_apportionment_date),
     col_list AS ( -- c_tsa_list
       SELECT mgmt_unit_name AS tsa_mgmt_unit_sort_order, mgmt_unit_number AS tsa_mgmt_unit_number FROM tsa
       UNION
       SELECT mgmt_unit_name, mgmt_unit_number || 'percent' FROM tsa
       UNION
       SELECT '0', 'Total ha' FROM dual
       UNION
       SELECT '0', 'Total percentage' FROM dual),
     col_rank AS (
       SELECT tsa_mgmt_unit_number,
              ROW_NUMBER() OVER (ORDER BY tsa_mgmt_unit_sort_order, tsa_mgmt_unit_number) AS rnk
         FROM col_list),
     col_window AS (
       SELECT tsa_mgmt_unit_number
         FROM col_rank
        WHERE rnk BETWEEN $P{p_in_col_start} AND $P{p_in_col_start} + $P{p_in_col_count} - 1),
     col_remaining AS (
       SELECT COUNT(CASE WHEN rnk > $P{p_in_col_start} + $P{p_in_col_count} - 1 THEN 1 END)
                AS remaining_tsa_count
         FROM col_rank),
     foa_ha AS ( -- Q_HA_AFTV: the region's FOAs with hectares apportioned
       SELECT DISTINCT aftv.code_argument   AS foa_code,
                       aftv.expanded_result AS foa_description,
                       aftv.sort_order      AS foa_sort_order
         FROM aftv,
              the.apt_part_apportionments papt,
              the.apt_partitions          part,
              the.apt_mgmt_unit_history   muh,
              the.apt_management_units    mu
        WHERE aftv.apt_mgmt_unit_st = 'U'
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND aftv.expiry_date > CAST($P{p_in_rpt_date} AS DATE)
          AND aftv.code_argument = papt.apt_foa_st
          AND papt.allowable_annual_cut_ha > 0
          AND papt.part_id = part.id
          AND part.muh_id = muh.id
          AND muh.mu_id = mu.id
          AND mu.org_unit_no = $P{p_in_region_org_unit_no}
          AND mu.apt_mgmt_unit_st = 'U'),
     col_labels AS ( -- CG$Q_B_PAPT_part1
       SELECT org_unit_no AS region_mu_ou_no,
              mgmt_unit_name AS tsa_mgmt_unit_sort_order,
              mgmt_unit_name AS tsa_mgmt_unit_name,
              mgmt_unit_number AS tsa_mgmt_unit_number,
              ' ha' AS tsa_units
         FROM tsa
       UNION
       SELECT org_unit_no, mgmt_unit_name, mgmt_unit_name, mgmt_unit_number || 'percent', '%' FROM tsa
       UNION
       SELECT 0, '0', 'Total ha', 'Total ha', ' ha' FROM dual
       UNION
       SELECT 0, '0', 'Total ha', 'Total percentage', '%' FROM dual),
     papt_ha AS ( -- Q_PAPT_HA part A
       SELECT SUM(papt.allowable_annual_cut_ha) AS sum_papt_aac_ha,
              papt.apt_foa_st                   AS foa_code,
              mu.mgmt_unit_number,
              mu.apt_mgmt_unit_st
         FROM the.apt_part_apportionments papt,
              the.apt_partitions          part,
              aprv                        aprvh,
              the.apt_management_units    mu,
              the.apt_mgmt_unit_history   muh
        WHERE mu.apt_mgmt_unit_st = 'U'
          AND mu.id = muh.mu_id
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND muh.id = part.muh_id
          AND part.apt_partition_st = aprvh.part_type_cd
          AND papt.part_id = part.id
          AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
              || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
              (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                          || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
                 FROM the.apt_mgmt_unit_history h
                WHERE h.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
                  AND h.mu_id = muh.mu_id)
          AND mu.org_unit_no = $P{p_in_region_org_unit_no}
        GROUP BY papt.apt_foa_st,
                 mu.apt_mgmt_unit_st,
                 mu.mgmt_unit_number),
     tsa_ha_total AS ( -- APT_RPT_APTR013_PART_HA_TOTALS, per management unit number
       SELECT mu.mgmt_unit_number,
              SUM(papt.allowable_annual_cut_ha) AS total
         FROM the.apt_part_apportionments papt,
              the.apt_partitions          part,
              aprv                        aprvh,
              the.apt_management_units    mu,
              the.apt_mgmt_unit_history   muh
        WHERE mu.apt_mgmt_unit_st = 'U'
          AND mu.id = muh.mu_id
          AND muh.id = part.muh_id
          AND part.apt_partition_st = aprvh.part_type_cd
          AND papt.part_id = part.id
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
              || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
              (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                          || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
                 FROM the.apt_mgmt_unit_history h
                WHERE h.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
                  AND h.mu_id = muh.mu_id)
          AND papt.apt_foa_st IN (SELECT DISTINCT a.code_argument
                                    FROM aftv a,
                                         the.apt_part_apportionments papt2,
                                         the.apt_partitions          part2,
                                         the.apt_mgmt_unit_history   muh2,
                                         the.apt_management_units    mu2
                                   WHERE a.apt_mgmt_unit_st = 'U'
                                     AND a.expiry_date > CAST($P{p_in_rpt_date} AS DATE)
                                     AND a.code_argument = papt2.apt_foa_st
                                     AND papt2.allowable_annual_cut_ha > 0
                                     AND papt2.part_id = part2.id
                                     AND part2.muh_id = muh2.id
                                     AND muh2.mu_id = mu2.id
                                     AND mu2.mgmt_unit_number = mu.mgmt_unit_number
                                     AND (mu2.mgmt_unit_status_st = 'ACT' OR mu2.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
                                     AND mu2.apt_mgmt_unit_st = 'U')
        GROUP BY mu.mgmt_unit_number),
     reg_foa AS ( -- APTR.REG_PAPT_FOA_AAC_HA for the region, per FOA
       SELECT papt.apt_foa_st,
              SUM(papt.allowable_annual_cut_ha) AS total
         FROM the.apt_part_apportionments papt,
              the.apt_partitions          part,
              aprv,
              the.apt_management_units    mu,
              the.apt_mgmt_unit_history   muh
        WHERE mu.org_unit_no = $P{p_in_region_org_unit_no}
          AND mu.apt_mgmt_unit_st = 'U'
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND mu.id = muh.mu_id
          AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
              || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
              (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                          || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
                 FROM the.apt_mgmt_unit_history h
                WHERE h.mu_id = mu.id
                  AND h.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
                  AND NVL(h.apportionment_effective_date, TO_DATE('1900', 'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE))
          AND muh.id = part.muh_id
          AND part.id = papt.part_id
          AND part.apt_partition_st = aprv.part_type_cd
        GROUP BY papt.apt_foa_st),
     foa_total AS ( -- part C rows: APTR.REG_PAPT_FOA_AAC_HA per FOA (0 when none)
       SELECT aftv.code_argument,
              NVL(rf.total, 0) AS foa_total
         FROM aftv
         LEFT JOIN reg_foa rf ON rf.apt_foa_st = aftv.code_argument
        WHERE aftv.apt_mgmt_unit_st = 'U'
          AND aftv.expiry_date > CAST($P{p_in_rpt_date} AS DATE)),
     grand AS ( -- v_q_ha_aftv_total: NULL when the region has no FOA with hectares
       SELECT SUM(NVL(rf.total, 0)) AS grand_total
         FROM foa_ha fh
         LEFT JOIN reg_foa rf ON rf.apt_foa_st = fh.foa_code),
     papt_all AS ( -- Q_PAPT_HA
       SELECT sum_papt_aac_ha, foa_code, mgmt_unit_number, apt_mgmt_unit_st
         FROM papt_ha
       UNION
       SELECT DECODE(ph.sum_papt_aac_ha,
                     NULL, TO_NUMBER(NULL),
                     0, 0,
                     DECODE(tt.total, NULL, TO_NUMBER(NULL), 0, 0,
                            ph.sum_papt_aac_ha / tt.total * 100)),
              ph.foa_code,
              ph.mgmt_unit_number || 'percent',
              ph.apt_mgmt_unit_st
         FROM papt_ha ph
         LEFT JOIN tsa_ha_total tt ON tt.mgmt_unit_number = ph.mgmt_unit_number
       UNION
       SELECT ft.foa_total, ft.code_argument, 'Total ha', 'U'
         FROM foa_total ft
       UNION
       SELECT DECODE(g.grand_total, NULL, TO_NUMBER(NULL), 0, 0, ft.foa_total / g.grand_total * 100),
              ft.code_argument, 'Total percentage', 'U'
         FROM foa_total ft,
              grand g)
SELECT region_mu_ou_no, foa_sort_order, foa_code, foa_description, tsa_mgmt_unit_sort_order,
       tsa_mgmt_unit_number, tsa_mgmt_unit_name, tsa_units, sum_papt_aac_ha, remaining_tsa_count
  FROM (SELECT cl.region_mu_ou_no,
               fh.foa_sort_order,
               fh.foa_code,
               fh.foa_description,
               cl.tsa_mgmt_unit_sort_order,
               cl.tsa_mgmt_unit_number,
               cl.tsa_mgmt_unit_name,
               cl.tsa_units,
               pa.sum_papt_aac_ha,
               cr.remaining_tsa_count
          FROM foa_ha fh
         CROSS JOIN col_labels cl
          LEFT JOIN papt_all pa
            ON pa.mgmt_unit_number = cl.tsa_mgmt_unit_number
           AND pa.foa_code = fh.foa_code
         CROSS JOIN col_remaining cr
         WHERE EXISTS (SELECT 1
                         FROM col_window cw
                        WHERE cw.tsa_mgmt_unit_number LIKE '%' || cl.tsa_mgmt_unit_number || '%')
        UNION ALL
        -- No column in range: the procedure's single dummy row
        SELECT -1, -1, 'dummy', 'dummy', 'dummy', 'dummy', 'dummy', 'dummy', -1, -1
          FROM dual
         WHERE NOT EXISTS (SELECT 1 FROM col_window))
 ORDER BY region_mu_ou_no,
          tsa_mgmt_unit_name,
          foa_sort_order]]>
	</queryString>
	<field name="REGION_MU_OU_NO" class="java.math.BigDecimal"/>
	<field name="FOA_SORT_ORDER" class="java.math.BigDecimal"/>
	<field name="FOA_CODE" class="java.lang.String"/>
	<field name="FOA_DESCRIPTION" class="java.lang.String"/>
	<field name="TSA_MGMT_UNIT_SORT_ORDER" class="java.lang.String"/>
	<field name="TSA_MGMT_UNIT_NUMBER" class="java.lang.String"/>
	<field name="TSA_MGMT_UNIT_NAME" class="java.lang.String"/>
	<field name="TSA_UNITS" class="java.lang.String"/>
	<field name="SUM_PAPT_AAC_HA" class="java.math.BigDecimal"/>
	<field name="REMAINING_TSA_COUNT" class="java.math.BigDecimal"/>
	<filterExpression><![CDATA[$F{SUM_PAPT_AAC_HA} != null && $F{SUM_PAPT_AAC_HA}.doubleValue() > 0.0]]></filterExpression>
	<background>
