<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR041_FOA_DESC" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="37be40f7-d858-429a-b48c-3b894c7caea3">
	<!-- Was THE.APT_RPTAPTR041_FOA_DESC; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[SELECT DISTINCT lic.apt_foa_st,
                aftv.expanded_result
  FROM the.apt_licences    lic,
       the.apt_commitments comm,
       (-- APT_FOA_TYPES_V
        SELECT clt.code_argument,
               clt.expanded_result,
               clt.expiry_date
          FROM the.code_list_table clt,
               the.code_subset_tbl cst,
               the.apt_apportionment_categories acat
         WHERE cst.code_subset_name = 'APT_FOA_ST'
           AND clt.column_name = cst.column_name
           AND clt.code_argument = cst.code_argument
           AND acat.apt_foa_st = clt.code_argument) aftv
 WHERE lic.forest_file_id = comm.forest_file_id AND
       SYSDATE BETWEEN comm.effective_date AND
       nvl(comm.expiry_date,
           to_date('299912312359',
                   'yyyymmddhh24mi')) AND
       comm.include_in_lic_aac_ind = 'Y' AND
       aftv.code_argument = lic.apt_foa_st AND
       aftv.expiry_date > SYSDATE
 ORDER BY lic.apt_foa_st]]>
	</queryString>
	<field name="APT_FOA_ST" class="java.lang.String"/>
	<field name="EXPANDED_RESULT" class="java.lang.String"/>
