<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR0033_AAC_HA" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="1d86cefa-2a84-4a06-b122-0a1093234a92">
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR033_AAC_HA; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[  SELECT cuts_ha.ab_apt_mgmt_unit_st,
      regions_ha.aa_org_unit_code || ' (ha)' org_unit_label,
      cuts_ha.sum_aac_ha sum_aac
 FROM (-- cuts_ha
       -- gets the bulk of the data
       SELECT decode(mu.apt_mgmt_unit_st,
                     'U',
                     'Timber Supply Areas (TSA)',
                     'T',
                     'Tree Farm Licences (TFL)')         ab_apt_mgmt_unit_st,
              mu.org_unit_no mu_org_unit_no,
              SUM(muh.allowable_annual_cut_ha)            sum_aac_ha
         FROM the.apt_management_units  mu,
              the.apt_mgmt_unit_history muh
        WHERE mu.mgmt_unit_status_st = 'ACT' AND
              mu.apt_mgmt_unit_st IN ('T', 'U') AND mu.id = muh.mu_id AND
              to_char(muh.effective_date,
                      'YYYYMMDD') ||
              to_char(nvl(muh.apportionment_effective_date,
                          to_date('29991231',
                                  'YYYYMMDD')),
                      'YYYYMMDD') =
              (SELECT MAX(to_char(effective_date,
                                  'YYYYMMDD') ||
                          to_char(nvl(apportionment_effective_date,
                                      to_date('29991231',
                                              'YYYYMMDD')),
                                  'YYYYMMDD'))
                 FROM the.apt_mgmt_unit_history muh
                WHERE mu_id = mu.id AND effective_date <= SYSDATE AND
                      nvl(apportionment_effective_date,
                          to_date('1900',
                                  'YYYY')) <= SYSDATE)
        GROUP BY decode(mu.apt_mgmt_unit_st,
                        'U',
                        'Timber Supply Areas (TSA)',
                        'T',
                        'Tree Farm Licences (TFL)'),
                 mu.org_unit_no) cuts_ha,
      (-- regions_ha
       -- gets the org units of the regions
       SELECT ou.org_unit_code aa_org_unit_code,
              ou.org_unit_no   org_unit_no
         FROM the.org_unit ou
        WHERE ou.org_unit_code LIKE 'R__' AND effective_date <= CAST($P{p_in_rpt_date} AS DATE)
              AND expiry_date >= CAST($P{p_in_rpt_date} AS DATE)
       ) regions_ha
WHERE cuts_ha.mu_org_unit_no = regions_ha.org_unit_no]]>
	</queryString>
	<field name="AB_APT_MGMT_UNIT_ST" class="java.lang.String"/>
	<field name="ORG_UNIT_LABEL" class="java.lang.String"/>
	<field name="SUM_AAC" class="java.math.BigDecimal"/>
	<filterExpression><![CDATA[$F{SUM_AAC} != null && $F{SUM_AAC}.doubleValue() > 0.0]]></filterExpression>
