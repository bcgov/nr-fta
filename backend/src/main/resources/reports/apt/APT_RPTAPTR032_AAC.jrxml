<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR032_AAC" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="53e6371c-8578-4052-8427-21aef8f80f76">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR032_AAC; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[SELECT decode(mu.apt_mgmt_unit_st,
              'U',
              1,
              'T',
              2)    sort_order --, 'F', 2) #2
      ,
      decode(mu.apt_mgmt_unit_st,
              'U',
              'Timber Supply Area (TSA)',
              'T',
              'Tree Farm Licences (TFL)')    apt_mgmt_unit_st --, 'F', 'WL' #2
      ,
       SUM(muh.allowable_annual_cut)       sum_aac,
       SUM(muh.allowable_annual_cut_ha)       sum_aac_ha,
       CASE WHEN COUNT(SUM(muh.allowable_annual_cut_ha)) OVER () > 0 THEN 'Y' ELSE 'N' END show_ha_ind
  FROM the.apt_management_units  mu,
       the.apt_mgmt_unit_history muh
 WHERE (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) --RY U42 --#1
       AND mu.apt_mgmt_unit_st IN ('T', 'U') --, 'F' #2
       AND mu.id = muh.mu_id AND
       to_char(muh.effective_date,
               'YYYYMMDD') ||
       to_char(nvl(muh.apportionment_effective_date,
                   to_date('29991231',
                           'YYYYMMDD')),
               'YYYYMMDD') =
       (SELECT MAX(to_char(effective_date,
                           'YYYYMMDD') ||
                   to_char(nvl(apportionment_effective_date,
                               to_date('29991231',
                                       'YYYYMMDD')),
                           'YYYYMMDD'))
          FROM the.apt_mgmt_unit_history muh
         WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
               nvl(apportionment_effective_date,
                   to_date('1900',
                           'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE))
 GROUP BY decode(mu.apt_mgmt_unit_st,
                 'U',
                 1,
                 'T',
                 2) --, 'F', 2 #2
         ,
          decode(mu.apt_mgmt_unit_st,
                 'U',
                 'Timber Supply Area (TSA)',
                 'T',
                 'Tree Farm Licences (TFL)')]]>
	</queryString>
	<field name="SORT_ORDER" class="java.math.BigDecimal"/>
	<field name="APT_MGMT_UNIT_ST" class="java.lang.String"/>
	<field name="SUM_AAC" class="java.math.BigDecimal"/>
	<field name="SUM_AAC_HA" class="java.math.BigDecimal"/>
	<field name="SHOW_HA_IND" class="java.lang.String"/>
	<variable name="sum_of_SUM_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC_HA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_HA}]]></variableExpression>
	</variable>
	<group name="SORT_ORDER">
		<groupExpression><![CDATA[$F{SORT_ORDER}]]></groupExpression>
	</group>
