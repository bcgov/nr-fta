<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR013_AAC" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="00f28866-5d6b-4397-9bd2-57479e2f8cb8">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<parameter name="p_in_region_org_unit_no" class="java.math.BigDecimal"/>
	<!-- Was THE.APT_RPTAPTR013_AAC; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- The procedure fetched the region's grand totals into variables first (same FROM/WHERE as the
-- result), defaulted them to 0, then divided each row by them; here the grand totals are the
-- analytic sum of the grouped sums over the same rows.
WITH
     munv AS ( -- APT_MGMT_UNIT_NAMES_V
       SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                   AS apt_mgmt_unit_st,
              clt.code_argument     AS mgmt_unit_number,
              clt.expanded_result   AS mgmt_unit_name
         FROM the.code_list_table clt
        WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
       UNION
       SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
              NULL,
              clt2.expanded_result
         FROM the.code_list_table clt2
        WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
          AND clt2.code_argument = 'Z')
SELECT CAST($P{p_in_region_org_unit_no} AS NUMBER) AS reg_org_unit_no,
       munv.mgmt_unit_name                          AS mu_name,
       muh.determination_date                       AS mu_determination_date,
       muh.effective_date                           AS mu_effective_date,
       SUM(muh.allowable_annual_cut)                AS sum_aac_m3,
       DECODE(NVL(SUM(SUM(muh.allowable_annual_cut)) OVER (), 0), 0, 0,
              SUM(muh.allowable_annual_cut) / SUM(SUM(muh.allowable_annual_cut)) OVER () * 100)
                                                    AS sum_aac_m3_percent,
       SUM(muh.allowable_annual_cut_ha)             AS sum_aac_ha,
       DECODE(NVL(SUM(SUM(muh.allowable_annual_cut_ha)) OVER (), 0), 0, 0,
              SUM(muh.allowable_annual_cut_ha) / SUM(SUM(muh.allowable_annual_cut_ha)) OVER () * 100)
                                                    AS sum_aac_ha_percent
  FROM the.apt_management_units  mu,
       the.apt_mgmt_unit_history muh,
       munv
 WHERE muh.mu_id = mu.id
   AND mu.org_unit_no = $P{p_in_region_org_unit_no}
   AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
   AND mu.apt_mgmt_unit_st = 'U'
   AND mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st
   AND mu.mgmt_unit_number = munv.mgmt_unit_number
   AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
       || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
       (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                   || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
          FROM the.apt_mgmt_unit_history h
         WHERE h.mu_id = mu.id
           AND h.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
           AND NVL(h.apportionment_effective_date, TO_DATE('1900', 'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE))
 GROUP BY munv.mgmt_unit_name,
          muh.determination_date,
          muh.effective_date]]>
	</queryString>
	<field name="REG_ORG_UNIT_NO" class="java.math.BigDecimal"/>
	<field name="MU_NAME" class="java.lang.String"/>
	<field name="MU_DETERMINATION_DATE" class="java.sql.Timestamp"/>
	<field name="MU_EFFECTIVE_DATE" class="java.sql.Timestamp"/>
	<field name="SUM_AAC_M3" class="java.math.BigDecimal"/>
	<field name="SUM_AAC_M3_PERCENT" class="java.math.BigDecimal"/>
	<field name="SUM_AAC_HA" class="java.math.BigDecimal"/>
	<field name="SUM_AAC_HA_PERCENT" class="java.math.BigDecimal"/>
	<variable name="sum_of_SUM_AAC_M3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_M3}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC_HA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_HA}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC_M3_PERCENT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_M3_PERCENT}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC_HA_PERCENT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_HA_PERCENT}]]></variableExpression>
	</variable>
