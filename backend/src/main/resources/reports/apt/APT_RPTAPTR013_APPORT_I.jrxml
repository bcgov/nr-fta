								<printWhenExpression><![CDATA[$V{SUM_PAPT_AACMeasure_FOA_DESCRIPTION_TSA_MGMT_UNIT_SORT_ORDER_ALL} != null && $V{SUM_PAPT_AACMeasure_FOA_DESCRIPTION_TSA_MGMT_UNIT_SORT_ORDER_ALL}.doubleValue() > 0.0]]></printWhenExpression>
