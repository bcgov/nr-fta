<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR012_AAC_BY_PART" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="755cd587-b2bb-4e99-8497-d51ab9bb5485">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<parameter name="p_in_org_unit_no" class="java.math.BigDecimal"/>
	<!-- Was THE.APT_RPTAPTR012_AAC_BY_PART; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[WITH prm AS (
  SELECT CAST($P{p_in_rpt_date} AS DATE) AS rpt_date,
         $P{p_in_org_unit_no}            AS org_unit_no
    FROM dual
)
SELECT ptv.part_type_desc                AS part_type_desc,
       SUM(part.allowable_annual_cut)    AS sum_part_aac,
       SUM(part.allowable_annual_cut_ha) AS sum_part_aac_ha,
       mu.org_unit_no                    AS mu_ou_no
  FROM the.apt_partitions part,
       (SELECT clt.code_argument   AS part_type_cd,
               clt.expanded_result AS part_type_desc
          FROM the.code_list_table clt,
               the.code_subset_tbl cst
         WHERE cst.code_subset_name = 'APT_PART_RPT_ST'
           AND clt.column_name = cst.column_name
           AND clt.code_argument = cst.code_argument) ptv,
       the.apt_management_units mu,
       the.apt_mgmt_unit_history muh,
       prm
 WHERE ptv.part_type_cd = part.apt_partition_st
   AND muh.id = part.muh_id
   AND muh.mu_id = mu.id
   AND mu.apt_mgmt_unit_st = 'U'
   AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > prm.rpt_date)
   AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
       || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD')
       = (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                     || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
            FROM the.apt_mgmt_unit_history h
           WHERE h.mu_id = mu.id
             AND h.effective_date <= prm.rpt_date
             AND NVL(h.apportionment_effective_date, TO_DATE('1900', 'YYYY')) <= prm.rpt_date)
   AND mu.org_unit_no = prm.org_unit_no
 GROUP BY ptv.part_type_desc,
          mu.org_unit_no]]>
	</queryString>
	<field name="PART_TYPE_DESC" class="java.lang.String"/>
	<field name="SUM_PART_AAC" class="java.math.BigDecimal"/>
	<field name="SUM_PART_AAC_HA" class="java.math.BigDecimal"/>
	<field name="MU_OU_NO" class="java.math.BigDecimal"/>
	<variable name="sum_of_SUM_PART_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_PART_AAC}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_PART_AAC_HA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_PART_AAC_HA}]]></variableExpression>
	</variable>
	<variable name="Percent_ha" class="java.lang.Double">
		<variableExpression><![CDATA[($F{SUM_PART_AAC_HA}.doubleValue()/$V{sum_of_SUM_PART_AAC_HA}.doubleValue())*100.0]]></variableExpression>
	</variable>
	<variable name="Percent_m3" class="java.lang.Double">
		<variableExpression><![CDATA[($F{SUM_PART_AAC}.doubleValue()/$V{sum_of_SUM_PART_AAC}.doubleValue())*100.0]]></variableExpression>
	</variable>
