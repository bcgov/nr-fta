	</variable>
	<variable name="expiryDate" class="java.sql.Timestamp">
		<variableExpression><![CDATA[( $F{EXPIRY_DATE}.after( $F{INIT_EXPIRY_DT} ) ? $F{EXPIRY_DATE} : $F{INIT_EXPIRY_DT} )]]></variableExpression>
	</variable>
