                                   mu.mgmt_unit_number AND
                                   munv.apt_mgmt_unit_st =
                                   mu.apt_mgmt_unit_st AND
                                   mu.mgmt_unit_status_st = 'ACT' -- CR7
                                   AND
                                   mu.apt_mgmt_unit_st IN ('T', 'U') AND
                                   mu.apt_mgmt_unit_st =
                                   pfu.mgmt_unit_type AND
                                   mu.mgmt_unit_number =
                                   pfu.mgmt_unit_id AND
                                   tt.forest_file_id =
                                   pfu.forest_file_id AND
                                   (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                          to_date('9999-12-31','YYYY-MM-DD'), --CR13
                                          tt.initial_expiry_dt,
                                          tt.current_expiry_dt) > SYSDATE) AND --CR13
                                   SYSDATE BETWEEN comm.effective_date AND
                                   nvl(comm.expiry_date,
                                       to_date('299912312359','yyyymmddhh24mi')) AND
                                  -- and comm.include_in_lic_aac_ind = 'Y'                   -- CR01-03
                                   comm.include_in_lic_aac_ind = 'N' AND -- CR01-03
                                   comm.apt_partition_st = 'UAV' AND -- CR01-03
                                   lic.forest_file_id = comm.forest_file_id AND
                                   lic.forest_file_id = pfu.forest_file_id AND
