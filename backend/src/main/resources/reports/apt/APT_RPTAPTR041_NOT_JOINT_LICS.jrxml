<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR041_NOT_JOINT_LICS" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="1a56c332-461d-4e79-ae86-4afeecd89da4">
	<!-- Was THE.APT_RPTAPTR041_NOT_JOINT_LICS; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- APT_RPT_COUNT_LICENCEES and APT_INDEP_SIZE are inlined as scalar subqueries:
-- the count of the rows of the licence in APT_LICENCE_CLIENTS_V (licence_clients below); the
-- summed commitments of the licence rounded into NUMBER(11), >= 25000 is 1 (medium), else 2
-- (small, also when there are none), 0 on overflow (the WHEN OTHERS of the function).
WITH munv AS (
    -- APT_MGMT_UNIT_NAMES_V
    SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                AS apt_mgmt_unit_st,
           clt.code_argument     AS mgmt_unit_number,
           clt.expanded_result   AS mgmt_unit_name
      FROM the.code_list_table clt
     WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
    UNION
    SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
           NULL,
           clt2.expanded_result
      FROM the.code_list_table clt2
     WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
       AND clt2.code_argument = 'Z'
),
licence_clients AS (
    -- APT_LICENCE_CLIENTS_V (V_CLIENT_PUBLIC is FOREST_CLIENT)
    SELECT DISTINCT lic.forest_file_id,
           DECODE(vcp.client_type_code, 'I',
                  vcp.client_name || CHR(10) || '     ,' || vcp.legal_first_name,
                  vcp.client_name) AS client_name,
           fcl.file_client_type,
           vcp.client_number
      FROM the.apt_licences lic,
           the.for_client_link fcl,
           the.forest_client vcp
     WHERE lic.forest_file_id = fcl.forest_file_id
       AND vcp.client_number = fcl.client_number
       AND fcl.file_client_type IN ('A', 'B')
),
rel_cli_v AS (
    -- APT_RELATED_CLIENTS_NAMES_V
    SELECT rel_cli.client_number,
           vcp_client.client_name,
           rel_cli.client_number_parented_by,
           vcp_parent.client_name AS parent_name
      FROM the.apt_related_clients rel_cli,
           the.forest_client vcp_client,
           the.forest_client vcp_parent
     WHERE rel_cli.client_number_parented_by = vcp_parent.client_number
       AND rel_cli.client_number = vcp_client.client_number
)
/*corp groups*/
    SELECT 'A' sort_order,
           rel_cli_v.parent_name break_group,
           vcp.client_name client_name,
           lic.forest_file_id forest_file_id,
           decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                   to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                   tt.current_expiry_dt) expiry_date,
           tt.initial_expiry_dt init_expiry_dt,
           ou.org_unit_code region_code,
           lic.apt_foa_st foa,
           munv.mgmt_unit_name mu_name,
           SUM(comm.allowable_annual_cut) aac,
           0 uav_volume, -- CR01-03
           ' ' uav -- CR01-03
      FROM the.apt_licences                lic,
           the.apt_commitments             comm,
           the.prov_forest_use             pfu,
           the.for_client_link             fcl,
           the.forest_client             vcp,
           rel_cli_v rel_cli_v,
           munv       munv,
           the.org_unit                    ou,
           the.apt_management_units        mu,
           the.tenure_term                 tt
     WHERE ou.org_unit_no = mu.org_unit_no AND
           munv.mgmt_unit_number = mu.mgmt_unit_number AND
           munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
           mu.mgmt_unit_status_st = 'ACT' -- CR7
           AND mu.apt_mgmt_unit_st IN ('T', 'U') AND
           mu.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
           mu.mgmt_unit_number = pfu.mgmt_unit_id AND
           tt.forest_file_id = pfu.forest_file_id AND
           (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                   to_date('9999-12-31','YYYY-MM-DD'), --CR13
                   tt.initial_expiry_dt,
                   tt.current_expiry_dt) > SYSDATE) --CR13
           AND SYSDATE BETWEEN comm.effective_date AND
           nvl(comm.expiry_date,
               to_date('299912312359',
                       'yyyymmddhh24mi')) AND
           comm.include_in_lic_aac_ind = 'Y' AND
           lic.forest_file_id = comm.forest_file_id AND
           lic.forest_file_id = pfu.forest_file_id
          -- AND PFU.FILE_STATUS_ST <> 'HC'       -- CR7
           AND pfu.file_status_st IN ('HI', 'HS') -- CR7
           AND lic.forest_file_id = fcl.forest_file_id AND
           fcl.file_client_type IN ('A', 'B') AND
           fcl.client_number = rel_cli_v.client_number AND
           vcp.client_number = fcl.client_number AND
          /*AND &P_NOT_JOINTLY_HELD*/
           1 = (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
     GROUP BY rel_cli_v.parent_name,
              lic.forest_file_id,
              vcp.client_name,
              tt.current_expiry_dt,
              tt.initial_expiry_dt,
              ou.org_unit_code,
              munv.mgmt_unit_name,
              lic.apt_foa_st
    UNION
        SELECT 'A' sort_order -- union for mgmt_unit_type = 'U'
              ,
               rel_cli_v.parent_name break_group,
               vcp.client_name client_name,
               lic.forest_file_id forest_file_id,
               decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                      to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                      tt.current_expiry_dt) expiry_date,
               tt.initial_expiry_dt init_expiry_dt,
               ou.org_unit_code region_code,
               lic.apt_foa_st foa,
               munv.mgmt_unit_name mu_name,
               SUM(comm.allowable_annual_cut) aac,
               0 uav_volume -- CR01-03
              ,
               ' ' uav -- CR01-03
          FROM the.apt_licences                lic,
               the.apt_commitments             comm,
               the.prov_forest_use             pfu,
               the.for_client_link             fcl,
               the.forest_client             vcp,
               rel_cli_v rel_cli_v,
               munv       munv,
               the.org_unit                    ou,
               the.apt_management_units        mu,
               the.tenure_term                 tt,
               the.apt_part_apportionments     papt,
               the.apt_partitions              part,
               the.apt_mgmt_unit_history       muh
         WHERE pfu.mgmt_unit_type = 'Z' AND
               pfu.forest_file_id = lic.forest_file_id AND
               lic.forest_file_id = comm.forest_file_id AND
               comm.papt_id = papt.id AND papt.part_id = part.id AND
               part.muh_id = muh.id AND muh.mu_id = mu.id AND
               mu.org_unit_no = ou.org_unit_no AND
               mu.mgmt_unit_status_st = 'ACT' -- CR7
               AND mu.mgmt_unit_number = munv.mgmt_unit_number AND
               mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st AND
               tt.forest_file_id = pfu.forest_file_id AND
               (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                       to_date('9999-12-31','YYYY-MM-DD'), --CR13
                       tt.initial_expiry_dt,
                       tt.current_expiry_dt) > SYSDATE) --CR13
               AND SYSDATE BETWEEN comm.effective_date AND
               nvl(comm.expiry_date,
                   to_date('299912312359',
                           'yyyymmddhh24mi')) AND
               comm.include_in_lic_aac_ind = 'Y' AND
               pfu.file_status_st IN ('HI', 'HS') -- CR7
               AND lic.forest_file_id = fcl.forest_file_id AND
               fcl.file_client_type IN ('A', 'B') AND
               fcl.client_number = rel_cli_v.client_number AND
               vcp.client_number = fcl.client_number AND
              /*AND &P_NOT_JOINTLY_HELD*/
               1 = (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
         GROUP BY rel_cli_v.parent_name,
                  lic.forest_file_id,
                  vcp.client_name,
                  tt.current_expiry_dt,
                  tt.initial_expiry_dt,
                  ou.org_unit_code,
                  munv.mgmt_unit_name,
                  lic.apt_foa_st
        UNION
        /*indep med*/
            SELECT 'B' sort_order,
                   'INDEPENDENT MEDIUM' break_group,
                   decode(vcp.client_type_code,
                          'I',
                          vcp.client_name || ', ' ||
                          vcp.legal_first_name,
                          vcp.client_name) client_name,
                   lic.forest_file_id forest_file_id,
                   decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                          to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                          tt.current_expiry_dt) expiry_date,
                   tt.initial_expiry_dt init_expiry_dt,
                   ou.org_unit_code region_code,
                   lic.apt_foa_st foa,
                   munv.mgmt_unit_name mu_name,
                   SUM(comm.allowable_annual_cut) aac,
                   0 uav_volume -- CR01-03
                  ,
                   ' ' uav -- CR01-03
              FROM the.apt_licences          lic,
                   the.apt_commitments       comm,
                   the.prov_forest_use       pfu,
                   the.for_client_link       fcl,
                   the.forest_client       vcp,
                   munv munv,
                   the.org_unit              ou,
                   the.apt_management_units  mu,
                   the.tenure_term           tt
             WHERE ou.org_unit_no = mu.org_unit_no AND
                   munv.mgmt_unit_number = mu.mgmt_unit_number AND
                   munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
                   mu.apt_mgmt_unit_st IN ('T', 'U') AND
                   mu.mgmt_unit_status_st = 'ACT' -- CR7
                   AND mu.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
                   mu.mgmt_unit_number = pfu.mgmt_unit_id AND
                   tt.forest_file_id = pfu.forest_file_id AND
                   (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                           to_date('9999-12-31','YYYY-MM-DD'), --CR13
                           tt.initial_expiry_dt,
                           tt.current_expiry_dt) > SYSDATE) --CR13
                   AND SYSDATE BETWEEN comm.effective_date AND
                   nvl(comm.expiry_date,
                       to_date('299912312359',
                               'yyyymmddhh24mi')) AND
                   comm.include_in_lic_aac_ind = 'Y' AND
                   lic.forest_file_id = comm.forest_file_id AND
                   lic.forest_file_id = pfu.forest_file_id
                  -- AND PFU.FILE_STATUS_ST <> 'HC'           -- CR7
                   AND pfu.file_status_st IN ('HI', 'HS') -- CR7
                   AND lic.forest_file_id = fcl.forest_file_id AND
                   fcl.file_client_type IN ('A', 'B') AND
                   fcl.client_number NOT IN
                   (SELECT DISTINCT client_number
                      FROM the.apt_related_clients) AND
                   1 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
                   vcp.client_number = fcl.client_number AND
                  /*AND &P_NOT_JOINTLY_HELD*/
                   1 = (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
             GROUP BY 'INDEPENDENT MEDIUM',
                      lic.forest_file_id,
                      decode(vcp.client_type_code,
                             'I',
                             vcp.client_name || ', ' ||
                             vcp.legal_first_name,
                             vcp.client_name),
                      tt.current_expiry_dt,
                      tt.initial_expiry_dt,
                      ou.org_unit_code,
                      munv.mgmt_unit_name,
                      lic.apt_foa_st
            UNION
            /* indep med with MGMT_UNIT_TYPE = 'Z' */
                SELECT 'B' sort_order,
                       'INDEPENDENT MEDIUM' break_group,
                       decode(vcp.client_type_code,
                              'I',
                              vcp.client_name || ', ' ||
                              vcp.legal_first_name,
                              vcp.client_name) client_name,
                       lic.forest_file_id forest_file_id,
                       decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                              to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                              tt.current_expiry_dt) expiry_date,
                       tt.initial_expiry_dt init_expiry_dt,
                       ou.org_unit_code region_code,
                       lic.apt_foa_st foa,
                       munv.mgmt_unit_name mu_name,
                       SUM(comm.allowable_annual_cut) aac,
                       0 uav_volume -- CR01-03
                      ,
                       ' ' uav -- CR01-03
                  FROM the.apt_licences            lic,
                       the.apt_commitments         comm,
                       the.prov_forest_use         pfu,
                       the.for_client_link         fcl,
                       the.forest_client         vcp,
                       the.apt_partitions          part,
                       the.apt_part_apportionments papt,
                       the.apt_mgmt_unit_history   muh,
                       munv   munv,
                       the.org_unit                ou,
                       the.apt_management_units    mu,
                       the.tenure_term             tt
                 WHERE pfu.mgmt_unit_type = 'Z' AND
                       pfu.forest_file_id = lic.forest_file_id AND
                       pfu.file_status_st IN ('HI', 'HS') -- CR7
                       AND lic.forest_file_id = comm.forest_file_id AND
                       comm.papt_id = papt.id AND
                       papt.part_id = part.id AND part.muh_id = muh.id AND
                       muh.mu_id = mu.id AND
                       mu.org_unit_no = ou.org_unit_no AND
                       mu.mgmt_unit_number = munv.mgmt_unit_number AND
                       mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st AND
                       mu.apt_mgmt_unit_st IN ('T', 'U') AND
                       mu.mgmt_unit_status_st = 'ACT' -- CR7
                      -- AND MU.APT_MGMT_UNIT_ST = PFU.MGMT_UNIT_TYPE               -- CR21
                      -- AND MU.MGMT_UNIT_NUMBER = PFU.MGMT_UNIT_ID                 -- CR21
                       AND pfu.forest_file_id = tt.forest_file_id AND
                       (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                               to_date('9999-12-31','YYYY-MM-DD'), --CR13
                               tt.initial_expiry_dt,
                               tt.current_expiry_dt) > SYSDATE) --CR13
                       AND SYSDATE BETWEEN comm.effective_date AND
                       nvl(comm.expiry_date,
                           to_date('299912312359',
                                   'yyyymmddhh24mi')) AND
                       comm.include_in_lic_aac_ind = 'Y' AND
                       lic.forest_file_id = fcl.forest_file_id AND
                       fcl.file_client_type IN ('A', 'B') AND
                       fcl.client_number NOT IN
                       (SELECT DISTINCT client_number
                          FROM the.apt_related_clients) AND
                       1 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
                       vcp.client_number = fcl.client_number AND
                      /*AND &P_NOT_JOINTLY_HELD*/
                       1 = (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
                 GROUP BY 'INDEPENDENT MEDIUM',
                          lic.forest_file_id,
                          decode(vcp.client_type_code,
                                 'I',
                                 vcp.client_name || ', ' ||
                                 vcp.legal_first_name,
                                 vcp.client_name),
                          tt.current_expiry_dt,
                          tt.initial_expiry_dt,
                          ou.org_unit_code,
                          munv.mgmt_unit_name,
                          lic.apt_foa_st
                UNION
                /*indep small*/
                    SELECT 'C' sort_order,
                           'INDEPENDENT SMALL' break_group,
                           decode(vcp.client_type_code,
                                  'I',
                                  vcp.client_name || ', ' ||
                                  vcp.legal_first_name,
                                  vcp.client_name) client_name,
                           lic.forest_file_id forest_file_id,
                           decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                  to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                                  tt.current_expiry_dt) expiry_date,
                           tt.initial_expiry_dt init_expiry_dt,
                           ou.org_unit_code region_code,
                           lic.apt_foa_st foa,
                           munv.mgmt_unit_name mu_name,
                           SUM(comm.allowable_annual_cut) aac,
                           0 uav_volume -- CR01-03
                          ,
                           ' ' uav -- CR01-03
                      FROM the.apt_licences          lic,
                           the.apt_commitments       comm,
                           the.prov_forest_use       pfu,
                           the.for_client_link       fcl,
                           the.forest_client       vcp,
                           munv munv,
                           the.org_unit              ou,
                           the.apt_management_units  mu,
                           the.tenure_term           tt
                     WHERE ou.org_unit_no = mu.org_unit_no AND
                           munv.mgmt_unit_number = mu.mgmt_unit_number AND
                           munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
                           mu.apt_mgmt_unit_st IN ('T', 'U') AND
                           mu.mgmt_unit_status_st = 'ACT' AND
                           mu.apt_mgmt_unit_st = pfu.mgmt_unit_type AND
                           mu.mgmt_unit_number = pfu.mgmt_unit_id AND
                           tt.forest_file_id = pfu.forest_file_id AND
                           (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                   to_date('9999-12-31','YYYY-MM-DD'), --CR13
                                   tt.initial_expiry_dt,
                                   tt.current_expiry_dt) > SYSDATE) --CR13
                           AND SYSDATE BETWEEN comm.effective_date AND
                           nvl(comm.expiry_date,
                               to_date('299912312359',
                                       'yyyymmddhh24mi')) AND
                           comm.include_in_lic_aac_ind = 'Y' AND
                           lic.forest_file_id = comm.forest_file_id AND
                           lic.forest_file_id = pfu.forest_file_id
                          -- AND PFU.FILE_STATUS_ST <> 'HC'       -- CR7
                           AND pfu.file_status_st IN ('HI', 'HS') -- CR7
                           AND lic.forest_file_id = fcl.forest_file_id AND
                           fcl.file_client_type IN ('A', 'B') AND
                           fcl.client_number NOT IN
                           (SELECT DISTINCT client_number
                              FROM the.apt_related_clients) AND
                           2 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
                           vcp.client_number = fcl.client_number AND
                          /*AND &P_NOT_JOINTLY_HELD*/
                           1 =
                           (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
                     GROUP BY 'INDEPENDENT SMALL',
                              lic.forest_file_id,
                              decode(vcp.client_type_code,
                                     'I',
                                     vcp.client_name || ', ' ||
                                     vcp.legal_first_name,
                                     vcp.client_name),
                              tt.current_expiry_dt,
                              tt.initial_expiry_dt,
                              ou.org_unit_code,
                              munv.mgmt_unit_name,
                              lic.apt_foa_st
                    UNION
                    /* indep small  with MGMT_UNIT_TYPE = 'Z' */
                        SELECT 'C' sort_order,
                               'INDEPENDENT SMALL' break_group,
                               decode(vcp.client_type_code,
                                      'I',
                                      vcp.client_name || ', ' ||
                                      vcp.legal_first_name,
                                      vcp.client_name) client_name,
                               lic.forest_file_id forest_file_id,
                               decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                      to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                                      tt.current_expiry_dt) expiry_date,
                               tt.initial_expiry_dt init_expiry_dt,
                               ou.org_unit_code region_code,
                               lic.apt_foa_st foa,
                               munv.mgmt_unit_name mu_name,
                               SUM(comm.allowable_annual_cut) aac,
                               0 uav_volume -- CR01-03
                              ,
                               ' ' uav -- CR01-03
                          FROM the.apt_licences            lic,
                               the.apt_commitments         comm,
                               the.prov_forest_use         pfu,
                               the.apt_part_apportionments papt,
                               the.apt_partitions          part,
                               the.apt_mgmt_unit_history   muh,
                               the.for_client_link         fcl,
                               the.forest_client         vcp,
                               munv   munv,
                               the.org_unit                ou,
                               the.apt_management_units    mu,
                               the.tenure_term             tt
                         WHERE pfu.mgmt_unit_type = 'Z' AND
                               pfu.forest_file_id = lic.forest_file_id AND
                               pfu.file_status_st IN ('HI', 'HS') -- CR7
                               AND
                               lic.forest_file_id = comm.forest_file_id AND
                               comm.papt_id = papt.id AND
                               papt.part_id = part.id AND
                               part.muh_id = muh.id AND
                               muh.mu_id = mu.id AND
                               mu.org_unit_no = ou.org_unit_no AND
                               mu.mgmt_unit_number =
                               munv.mgmt_unit_number AND
                               mu.apt_mgmt_unit_st =
                               munv.apt_mgmt_unit_st AND
                               mu.apt_mgmt_unit_st IN ('T', 'U') AND
                               mu.mgmt_unit_status_st = 'ACT'
                              --   AND MU.APT_MGMT_UNIT_ST = PFU.MGMT_UNIT_TYPE
                              --   AND MU.MGMT_UNIT_NUMBER = PFU.MGMT_UNIT_ID
                               AND
                               tt.forest_file_id = pfu.forest_file_id AND
                               (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                       to_date('9999-12-31','YYYY-MM-DD'), --CR13
                                       tt.initial_expiry_dt,
                                       tt.current_expiry_dt) > SYSDATE) --CR13
                               AND SYSDATE BETWEEN comm.effective_date AND
                               nvl(comm.expiry_date,
                                   to_date('299912312359',
                                           'yyyymmddhh24mi')) AND
                               comm.include_in_lic_aac_ind = 'Y' AND
                               lic.forest_file_id = fcl.forest_file_id AND
                               fcl.file_client_type IN ('A', 'B') AND
                               fcl.client_number NOT IN
                               (SELECT DISTINCT client_number
                                  FROM the.apt_related_clients) AND
                               2 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
                               vcp.client_number = fcl.client_number AND
                              /*AND &P_NOT_JOINTLY_HELD*/
                               1 =
                               (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
                         GROUP BY 'INDEPENDENT SMALL',
                                  lic.forest_file_id,
                                  decode(vcp.client_type_code,
                                         'I',
                                         vcp.client_name || ', ' ||
                                         vcp.legal_first_name,
                                         vcp.client_name),
                                  tt.current_expiry_dt,
                                  tt.initial_expiry_dt,
                                  ou.org_unit_code,
                                  munv.mgmt_unit_name,
                                  lic.apt_foa_st
                        UNION
                        /* Unapportioned Volumes */
                            SELECT 'A' sort_order,
                                   rel_cli_v.parent_name break_group,
                                   vcp.client_name client_name,
                                   lic.forest_file_id forest_file_id,
                                   decode(nvl(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                                          to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt,
                                          tt.current_expiry_dt) expiry_date,
                                   tt.initial_expiry_dt init_expiry_dt,
                                   ou.org_unit_code region_code,
                                   lic.apt_foa_st foa,
                                   munv.mgmt_unit_name mu_name,
                                   0 aac -- CR01-03
                                  ,
                                   SUM(comm.allowable_annual_cut) uav_volume -- CR01-03
                                  ,
                                   '#' uav -- CR01-03 This char must match the Report
                              FROM the.apt_licences                lic,
                                   the.apt_commitments             comm,
                                   the.prov_forest_use             pfu,
                                   the.for_client_link             fcl,
                                   the.forest_client             vcp,
                                   rel_cli_v rel_cli_v,
                                   munv       munv,
                                   the.org_unit                    ou,
                                   the.apt_management_units        mu,
