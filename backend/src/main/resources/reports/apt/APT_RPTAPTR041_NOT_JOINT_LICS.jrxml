                                                                   'yyyymmddhh24mi')) AND
                                                      -- and comm.include_in_lic_aac_ind = 'Y'                   -- CR01-03
                                                       comm.include_in_lic_aac_ind = 'N' AND -- CR01-03
                                                       comm.apt_partition_st =
                                                       'UAV' AND -- CR01-03
                                                       lic.forest_file_id = fcl.forest_file_id AND
                                                       fcl.file_client_type IN ('A', 'B') AND
                                                       fcl.client_number NOT IN
                                                           (SELECT DISTINCT client_number
                                                              FROM the.apt_related_clients) AND
                                                       2 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
                                                       vcp.client_number = fcl.client_number AND
                                                      /*AND &P_NOT_JOINTLY_HELD*/
                                                       1 = (SELECT COUNT(*) FROM licence_clients lc WHERE lc.forest_file_id = lic.forest_file_id)
                                                 GROUP BY 'INDEPENDENT SMALL',
                                                          lic.forest_file_id,
                                                          decode(vcp.client_type_code,
                                                                 'I',
                                                                 vcp.client_name || ', ' ||
                                                                 vcp.legal_first_name,
                                                                 vcp.client_name),
                                                          tt.current_expiry_dt,
                                                          tt.initial_expiry_dt,
                                                          ou.org_unit_code,
                                                          munv.mgmt_unit_name,
                                                          lic.apt_foa_st
                                                --order by SORT_ORDER, BREAK_GROUP, FOREST_FILE_ID
                                                 ORDER BY 1,
                                                          2,
                                                          4]]>
	</queryString>
	<field name="SORT_ORDER" class="java.lang.String"/>
	<field name="BREAK_GROUP" class="java.lang.String"/>
	<field name="CLIENT_NAME" class="java.lang.String"/>
