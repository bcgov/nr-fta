<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR012_AAC_BY_TSA" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="5d706efe-4806-41f9-9deb-0e772b54c872">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<parameter name="p_in_org_unit_no" class="java.math.BigDecimal"/>
	<!-- Was THE.APT_RPTAPTR012_AAC_BY_TSA; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[WITH prm AS (
  SELECT CAST($P{p_in_rpt_date} AS DATE) AS rpt_date,
         $P{p_in_org_unit_no}            AS org_unit_no
    FROM dual
)
SELECT munv.mgmt_unit_name               AS mu_name,
       muh.effective_date                AS mu_effective_date,
       SUM(muh.allowable_annual_cut)     AS sum_aac,
       SUM(muh.allowable_annual_cut_ha)  AS sum_aac_ha
  FROM the.apt_management_units mu,
       the.apt_mgmt_unit_history muh,
       (SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                     AS apt_mgmt_unit_st,
               clt.code_argument     AS mgmt_unit_number,
               clt.expanded_result   AS mgmt_unit_name
          FROM the.code_list_table clt
         WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
        UNION
        SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
               NULL,
               clt2.expanded_result
          FROM the.code_list_table clt2
         WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
           AND clt2.code_argument = 'Z') munv,
       prm
 WHERE muh.mu_id = mu.id
   AND mu.org_unit_no = prm.org_unit_no
   AND mu.apt_mgmt_unit_st = 'U'
   AND mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st
   AND mu.mgmt_unit_number = munv.mgmt_unit_number
   AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > prm.rpt_date)
   AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
       || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD')
       = (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                     || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
            FROM the.apt_mgmt_unit_history h
           WHERE h.mu_id = mu.id
             AND h.effective_date <= prm.rpt_date
             AND NVL(h.apportionment_effective_date, TO_DATE('1900', 'YYYY')) <= prm.rpt_date)
 GROUP BY munv.mgmt_unit_name,
          muh.effective_date]]>
	</queryString>
	<field name="MU_NAME" class="java.lang.String"/>
	<field name="MU_EFFECTIVE_DATE" class="java.sql.Timestamp"/>
	<field name="SUM_AAC" class="java.math.BigDecimal"/>
	<field name="SUM_AAC_HA" class="java.math.BigDecimal"/>
	<variable name="percent_ha" class="java.lang.Double">
		<variableExpression><![CDATA[($F{SUM_AAC_HA}.doubleValue()/$V{sum_of_SUM_AAC_HA}.doubleValue()) * 100.0]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC_HA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC_HA}]]></variableExpression>
	</variable>
	<variable name="sum_of_SUM_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM_AAC}]]></variableExpression>
	</variable>
	<variable name="percent_m3" class="java.lang.Double">
		<variableExpression><![CDATA[($F{SUM_AAC}.doubleValue()/$V{sum_of_SUM_AAC_HA}.doubleValue()) * 100.0]]></variableExpression>
	</variable>
