	<!-- Was THE.APT_RPTAPTR043_PROV_LINK_AAC; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- APT_INDEP_SIZE is inlined as a scalar subquery: the summed commitments of the licence rounded
-- into NUMBER(11), >= 25000 is 1 (medium), else 2 (small); overflow was 0 (WHEN OTHERS).
WITH grand_total AS (
    -- c_grand_total of the procedure, NULL set to 0
    SELECT NVL(SUM(muh.allowable_annual_cut), 0) prov_aac
      FROM the.apt_management_units  mu,
           the.apt_mgmt_unit_history muh
     WHERE mu.mgmt_unit_status_st = 'ACT'
           AND mu.apt_mgmt_unit_st IN ('T', 'U')
           AND mu.id = muh.mu_id AND
           to_char(muh.effective_date, 'YYYYMMDD') ||
           to_char(nvl(muh.apportionment_effective_date, to_date('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
           (SELECT MAX(to_char(effective_date, 'YYYYMMDD') ||
                       to_char(nvl(apportionment_effective_date, to_date('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
              FROM the.apt_mgmt_unit_history muh
             WHERE mu_id = mu.id AND effective_date <= SYSDATE AND
                   nvl(apportionment_effective_date, to_date('1900', 'YYYY')) <= SYSDATE)
),
prov_link_sum AS (
    -- APT_PROV_LINK_SUM_V (its UNION drops duplicate rows; kept)
    SELECT vcp.client_name client_name,
           pfu.forest_file_id,
           comm.allowable_annual_cut total_aac
      FROM the.apt_licences lic,
           the.apt_commitments comm,
           the.prov_forest_use pfu,
           the.tenure_term tt,
           the.for_client_link fcl,
           the.apt_related_clients rel_cli,
           the.forest_client vcp,
           the.apt_management_units mu
     WHERE SYSDATE BETWEEN comm.effective_date AND
           nvl(comm.expiry_date, to_date('299912312359','yyyymmddhh24mi'))
       AND comm.include_in_lic_aac_ind = 'Y'
       AND lic.forest_file_id = comm.forest_file_id
       AND lic.forest_file_id = pfu.forest_file_id
       AND pfu.file_status_st IN ('HI','HS')
       AND pfu.mgmt_unit_type IN ('T', 'U')
       AND pfu.mgmt_unit_type = mu.apt_mgmt_unit_st
       AND pfu.mgmt_unit_id = mu.mgmt_unit_number
       AND mu.mgmt_unit_status_st = 'ACT'
       AND pfu.forest_file_id = tt.forest_file_id
       AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                   to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt, tt.current_expiry_dt) > SYSDATE)
       AND pfu.forest_file_id = fcl.forest_file_id
       AND fcl.file_client_type IN ('A','B')
       AND fcl.client_number = rel_cli.client_number
       AND vcp.client_number = rel_cli.client_number_parented_by
    UNION
    SELECT vcp.client_name client_name,
           pfu.forest_file_id,
           comm.allowable_annual_cut
      FROM the.apt_licences lic,
           the.apt_commitments comm,
           the.prov_forest_use pfu,
           the.tenure_term tt,
           the.for_client_link fcl,
           the.apt_related_clients rel_cli,
           the.forest_client vcp,
           the.apt_management_units mu,
           the.apt_mgmt_unit_history muh,
           the.apt_partitions part,
           the.apt_part_apportionments papt
     WHERE SYSDATE BETWEEN comm.effective_date AND
           nvl(comm.expiry_date, to_date('299912312359','yyyymmddhh24mi'))
       AND comm.include_in_lic_aac_ind = 'Y'
       AND lic.forest_file_id = comm.forest_file_id
       AND lic.forest_file_id = pfu.forest_file_id
       AND pfu.file_status_st IN ('HI','HS')
       AND pfu.mgmt_unit_type = 'Z'
       AND pfu.forest_file_id = tt.forest_file_id
       AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                   to_date('9999-12-31','YYYY-MM-DD'), tt.initial_expiry_dt, tt.current_expiry_dt) > SYSDATE)
       AND comm.papt_id = papt.id
       AND papt.part_id = part.id
       AND part.muh_id = muh.id
       AND muh.mu_id = mu.id
       AND mu.mgmt_unit_status_st = 'ACT'
       AND pfu.forest_file_id = fcl.forest_file_id
       AND fcl.file_client_type IN ('A','B')
       AND fcl.client_number = rel_cli.client_number
       AND vcp.client_number = rel_cli.client_number_parented_by
),
jointly_held_ffid AS (
    -- APT_JOINTLY_HELD_FFID_V
    SELECT lic.forest_file_id
      FROM the.apt_licences lic
     WHERE 1 < (SELECT COUNT(*)
                  FROM the.for_client_link fcl,
                       the.prov_forest_use pfu
                 WHERE fcl.forest_file_id = lic.forest_file_id AND
                       fcl.file_client_type IN ('A', 'B') AND
                       pfu.forest_file_id = lic.forest_file_id AND
                       pfu.file_status_st IN ('HI', 'HS') AND
                       pfu.mgmt_unit_type IN ('T', 'U', 'Z'))
)
-- The procedure held the grand total in a variable; here the four aggregate branches are an inline
-- view and the percentage and provincial total are added outside it (a scalar subquery inside an
-- aggregate without GROUP BY is ORA-00937). Each branch still returns its one row when empty.
SELECT b.sort_order,
       b.client_name,
       b.count_ffid,
       b.aac,
       decode(g.prov_aac, 0, 0, b.aac / g.prov_aac * 100) percent_of_prov_aac,  --RY U42 0 DIV CHECK
       g.prov_aac provincial_total_m3
  FROM (
SELECT 'A' sort_order,
       client_name client_name,
       COUNT(DISTINCT pls.forest_file_id) count_ffid,
       SUM(total_aac) aac
  FROM prov_link_sum pls,
       the.prov_forest_use     pfu
 WHERE pls.forest_file_id = pfu.forest_file_id AND
       pfu.forest_file_id NOT IN
       (SELECT forest_file_id
          FROM jointly_held_ffid)
 GROUP BY client_name
UNION
/*INDEPENDENT MEDIUM*/
    SELECT 'B' sort_order,
           'INDEPENDENT MEDIUM' client_name,
           COUNT(DISTINCT lic.forest_file_id) count_ffid,
           SUM(comm.allowable_annual_cut) aac
      FROM the.apt_licences    lic,
           the.apt_commitments comm,
           the.prov_forest_use pfu,
           the.tenure_term     tt,
           the.for_client_link fcl
     WHERE SYSDATE BETWEEN comm.effective_date AND
           nvl(comm.expiry_date,
               to_date('299912312359',
                       'yyyymmddhh24mi')) AND
           comm.include_in_lic_aac_ind = 'Y' AND
           lic.forest_file_id = comm.forest_file_id AND
           lic.forest_file_id = pfu.forest_file_id
          -- AND PFU.FILE_STATUS_ST <> 'HC'   -- CR7
           AND pfu.file_status_st IN ('HI', 'HS') -- CR7
           AND pfu.forest_file_id = tt.forest_file_id --CR13
           AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                       to_date('9999-12-31','YYYY-MM-DD'), -- CR13
                       tt.initial_expiry_dt,
                       tt.current_expiry_dt) > SYSDATE) -- CR13
           AND pfu.mgmt_unit_type IN ('T', 'U', 'Z') -- CR21
           AND pfu.forest_file_id = fcl.forest_file_id AND
           fcl.file_client_type IN ('A', 'B') AND
           fcl.client_number NOT IN
           (SELECT DISTINCT client_number
              FROM the.apt_related_clients) AND
           1 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
           pfu.forest_file_id NOT IN
           (SELECT forest_file_id
              FROM jointly_held_ffid)
    UNION
    /*INDEPENDENT SMALL*/
        SELECT 'C' sort_order,
               'INDEPENDENT SMALL' client_name,
               COUNT(DISTINCT lic.forest_file_id) count_ffid,
               SUM(comm.allowable_annual_cut) aac
          FROM the.apt_licences    lic,
               the.apt_commitments comm,
               the.prov_forest_use pfu,
               the.tenure_term     tt,
               the.for_client_link fcl
         WHERE SYSDATE BETWEEN comm.effective_date AND
               nvl(comm.expiry_date,
                   to_date('299912312359',
                           'yyyymmddhh24mi')) AND
               comm.include_in_lic_aac_ind = 'Y' AND
               lic.forest_file_id = comm.forest_file_id AND
               lic.forest_file_id = pfu.forest_file_id
              -- AND PFU.FILE_STATUS_ST <> 'HC'   -- CR7
               AND pfu.file_status_st IN ('HI', 'HS') -- CR7
               AND pfu.forest_file_id = tt.forest_file_id --CR13
               AND (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                           to_date('9999-12-31','YYYY-MM-DD'), -- CR13
                           tt.initial_expiry_dt,
                           tt.current_expiry_dt) > SYSDATE) -- CR13
               AND pfu.mgmt_unit_type IN ('T', 'U', 'Z') -- CR21
               AND pfu.forest_file_id = fcl.forest_file_id AND
               fcl.file_client_type IN ('A', 'B') AND
               fcl.client_number NOT IN
               (SELECT DISTINCT client_number
                  FROM the.apt_related_clients) AND
               2 = (SELECT CASE WHEN ABS(ROUND(SUM(isz.allowable_annual_cut))) > 99999999999 THEN 0 WHEN ROUND(SUM(isz.allowable_annual_cut)) >= 25000 THEN 1 ELSE 2 END FROM the.apt_commitments isz WHERE isz.forest_file_id = lic.forest_file_id) AND
               pfu.forest_file_id NOT IN
               (SELECT forest_file_id
                  FROM jointly_held_ffid)
        UNION
        /* JOINTLY HELD */
            SELECT 'D' sort_order,
                   'JOINTLY HELD LICENCES' client_name,
                   COUNT(DISTINCT lic.forest_file_id) count_ffid,
                   SUM(comm.allowable_annual_cut) aac
              FROM the.apt_licences    lic,
                   the.tenure_term     tt,
                   the.apt_commitments comm
             WHERE SYSDATE BETWEEN comm.effective_date AND
                   nvl(comm.expiry_date,
                       to_date('299912312359',
                               'yyyymmddhh24mi')) AND
                   comm.include_in_lic_aac_ind = 'Y' AND
                   lic.forest_file_id = comm.forest_file_id AND
                   lic.forest_file_id = tt.forest_file_id AND
                   (decode(NVL(tt.current_expiry_dt,to_date('9999-12-31', 'YYYY-MM-DD')),
                           to_date('9999-12-31','YYYY-MM-DD'), -- CR13
                           tt.initial_expiry_dt,
                           tt.current_expiry_dt) > SYSDATE) -- CR13
                   AND lic.forest_file_id IN
                   (SELECT forest_file_id
                          FROM jointly_held_ffid)
       ) b,
       grand_total g
 ORDER BY b.sort_order,
          b.aac DESC]]>
	</queryString>
	<field name="SORT_ORDER" class="java.lang.String"/>
	<field name="CLIENT_NAME" class="java.lang.String"/>
	<field name="COUNT_FFID" class="java.math.BigDecimal"/>
	<field name="AAC" class="java.math.BigDecimal"/>
	<field name="PERCENT_OF_PROV_AAC" class="java.math.BigDecimal"/>
	<field name="PROVINCIAL_TOTAL_M3" class="java.math.BigDecimal"/>
	<variable name="total_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{AAC}]]></variableExpression>
	</variable>
	<variable name="total_PERCENT_OF_PROV_AAC" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PERCENT_OF_PROV_AAC}]]></variableExpression>
	</variable>
	<variable name="total_COUNT_FFID" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{COUNT_FFID}]]></variableExpression>
	</variable>
