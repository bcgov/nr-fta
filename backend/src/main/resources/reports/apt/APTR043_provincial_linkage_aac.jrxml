	<summary>
		<band height="306" splitType="Stretch">
			<textField isStretchWithOverflow="true" pattern="#,##0" isBlankWhenNull="true">
				<reportElement uuid="1cb03739-5e71-4de4-a509-4cf68b370587" x="283" y="11" width="45" height="11"/>
				<textElement textAlignment="Right">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{total_COUNT_FFID}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement uuid="c3d17abf-00d8-422e-bbd2-100863a2f67c" x="338" y="11" width="71" height="11"/>
				<textElement textAlignment="Right">
					<font fontName="DejaVu Sans" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{total_AAC}]]></textFieldExpression>
