<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR021_TFL_SUM_CROSS" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="d28e28da-aa2f-4e6c-9ee2-dc2a3d949478">
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR021_TFL_SUM_CROSS; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- The procedure first called APT_APT021_GRAND_TOTAL_GET (the sum of the MU AACs over exactly the
-- rows of the reg view below, 0 when NULL); here that is grand, summed over reg.
WITH
     aftv AS ( -- APT_FOA_TYPES_V
       SELECT clt.code_argument,
              clt.expanded_result,
              clt.effective_date,
              clt.expiry_date,
              acat.apt_mgmt_unit_st,
              acat.sort_order
         FROM the.code_list_table clt,
              the.code_subset_tbl cst,
              the.apt_apportionment_categories acat
        WHERE cst.code_subset_name = 'APT_FOA_ST'
          AND clt.column_name = cst.column_name
          AND clt.code_argument = cst.code_argument
          AND acat.apt_foa_st = clt.code_argument),
     reg AS ( -- the TFLs with their region, number, licensee and current AAC
       SELECT mu.id                    AS mu_id,
              ou.org_unit_code         AS reg_ou_code,
              mu.mgmt_unit_number      AS mu_no,
              vcp.client_name          AS lic_name,
              muh.effective_date       AS aac_effective_date,
              muh.allowable_annual_cut AS muh_aac
         FROM the.apt_management_units  mu,
              the.apt_mgmt_unit_history muh,
              the.org_unit              ou,
              the.forest_client         vcp, -- V_CLIENT_PUBLIC
              the.for_client_link       fcl,
              the.prov_forest_use       pfu,
              the.tenure_term           tt
        WHERE mu.org_unit_no = ou.org_unit_no
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND mu.apt_mgmt_unit_st = 'T'
          AND mu.id = muh.mu_id
          AND muh.effective_date = (SELECT MAX(muh2.effective_date)
                                      FROM the.apt_mgmt_unit_history muh2
                                     WHERE mu.id = muh2.mu_id)
          AND muh.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
          AND mu.apt_mgmt_unit_st = pfu.mgmt_unit_type
          AND mu.mgmt_unit_number = pfu.mgmt_unit_id
          AND pfu.file_status_st IN ('HI', 'HS')
          AND pfu.forest_file_id = 'TFL' || TRIM(LEADING '0' FROM pfu.mgmt_unit_id)
          AND pfu.forest_file_id = tt.forest_file_id
          AND DECODE(NVL(tt.current_expiry_dt, TO_DATE('9999-12-31', 'YYYY-MM-DD')),
                     TO_DATE('9999-12-31', 'YYYY-MM-DD'),
                     NVL(tt.initial_expiry_dt, TO_DATE('9999-12-31', 'YYYY-MM-DD')),
                     tt.current_expiry_dt) > CAST($P{p_in_rpt_date} AS DATE)
          AND pfu.forest_file_id = fcl.forest_file_id
          AND vcp.client_number = fcl.client_number
          AND fcl.file_client_type = 'A'),
     grand AS (
       SELECT NVL(SUM(muh_aac), 0) AS grand_total
         FROM reg),
     aacs AS ( -- the AAC per TFL and FOA, plus the Total and % columns
       SELECT mu.id             AS mu_id,
              mu.org_unit_no    AS reg_no,
              cj.commit_type_st AS foa_cd,
              aac.sort_order    AS sort_ord,
              SUM(cj.allowable_annual_cut) AS aac_amt
         FROM the.apt_management_units         mu,
              the.prov_forest_use              pfu,
              the.tenure_term                  tt,
              the.apt_commitments_jn           cj,
              the.apt_apportionment_categories aac
        WHERE mu.apt_mgmt_unit_st = 'T'
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND mu.mgmt_unit_number = pfu.mgmt_unit_id
          AND pfu.mgmt_unit_type = mu.apt_mgmt_unit_st
          AND pfu.file_status_st IN ('HI', 'HS')
          AND pfu.forest_file_id = tt.forest_file_id
          AND DECODE(NVL(tt.current_expiry_dt, TO_DATE('9999-12-31', 'YYYY-MM-DD')),
                     TO_DATE('9999-12-31', 'YYYY-MM-DD'),
                     NVL(tt.initial_expiry_dt, TO_DATE('9999-12-31', 'YYYY-MM-DD')),
                     tt.current_expiry_dt) > CAST($P{p_in_rpt_date} AS DATE)
          AND pfu.forest_file_id = cj.forest_file_id
          AND cj.include_in_lic_aac_ind = 'Y'
          AND cj.effective_date(+) <= CAST($P{p_in_rpt_date} AS DATE)
          AND NVL(cj.expiry_date, TO_DATE('2999-12-31', 'YYYY-MM-DD')) > CAST($P{p_in_rpt_date} AS DATE)
          AND NVL(cj.jn_datetime, TO_DATE('18001231', 'YYYYMMDD')) =
              (SELECT NVL(MAX(u.jn_datetime), TO_DATE('18001231', 'YYYYMMDD'))
                 FROM the.apt_commitments_jn u -- APT_UNDELETED_COMMJ_V
                WHERE u.id = cj.id
                  AND u.id NOT IN (SELECT d.id
                                     FROM the.apt_commitments_jn d
                                    WHERE d.jn_operation = 'DEL'))
          AND cj.commit_type_st = aac.apt_foa_st
          AND aac.apt_mgmt_unit_st = 'T'
        GROUP BY mu.id,
                 mu.org_unit_no,
                 cj.commit_type_st,
                 aac.sort_order
       UNION
       SELECT mu.id,
              mu.org_unit_no,
              papt.apt_foa_st,
              aftv.sort_order,
              SUM(papt.allowable_annual_cut)
         FROM the.apt_management_units    mu,
              the.apt_mgmt_unit_history   muh,
              the.apt_part_apportionments papt,
              the.apt_partitions          part,
              aftv
        WHERE muh.mu_id = mu.id
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND muh.effective_date = (SELECT MAX(muh2.effective_date)
                                      FROM the.apt_mgmt_unit_history muh2
                                     WHERE muh2.effective_date <= CAST($P{p_in_rpt_date} AS DATE)
                                       AND muh2.mu_id = mu.id)
          AND part.muh_id = muh.id
          AND part.id = papt.part_id
          AND aftv.code_argument = papt.apt_foa_st
          AND aftv.apt_mgmt_unit_st = 'T'
        GROUP BY mu.id,
                 mu.org_unit_no,
                 papt.apt_foa_st,
                 aftv.sort_order
       UNION
       SELECT mu.id, mu.org_unit_no, 'Total', 98, -1
         FROM the.apt_management_units mu
        WHERE (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
       UNION
       SELECT mu.id, mu.org_unit_no, '% of Total TFL AAC', 99, -2
         FROM the.apt_management_units mu
        WHERE (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))),
     col_names AS ( -- the crosstab column labels
       SELECT DISTINCT papt.apt_foa_st     AS foa_cd,
                       aftv.expanded_result AS expanded_result
         FROM the.apt_part_apportionments papt,
              the.apt_partitions          part,
              the.apt_management_units    mu,
              the.apt_mgmt_unit_history   muh,
              aftv
        WHERE mu.apt_mgmt_unit_st = 'T'
          AND muh.mu_id = mu.id
          AND part.muh_id = muh.id
          AND papt.part_id = part.id
          AND papt.apt_foa_st = aftv.code_argument
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND aftv.apt_mgmt_unit_st = 'T'
       UNION
       SELECT DISTINCT c.commit_type_st,
                       clt.expanded_result
         FROM the.apt_commitments              c,
              the.apt_management_units         mu,
              the.prov_forest_use              pfu,
              the.apt_apportionment_categories aac,
              the.code_list_table              clt,
              the.code_subset_tbl              cs
        WHERE mu.apt_mgmt_unit_st = 'T'
          AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE))
          AND pfu.mgmt_unit_id = mu.mgmt_unit_number
          AND pfu.forest_file_id = c.forest_file_id
          AND c.commit_type_st = aac.apt_foa_st
          AND aac.apt_mgmt_unit_st = 'T'
          AND c.commit_type_st = cs.code_argument
          AND cs.code_argument = clt.code_argument
          AND clt.column_name = cs.column_name
          AND cs.code_subset_name = 'COMMIT_TYPE_ST'
       UNION
       SELECT '% of Total TFL AAC', '% of Total TFL AAC' FROM dual
       UNION
       SELECT 'Total', 'Total' FROM dual)
SELECT reg.mu_id,
       papt.sort_ord             AS foa_desc_sort_order,
       col_names.expanded_result AS foa_desc,
       DECODE(papt.foa_cd,
              'Total', reg.muh_aac,
              '% of Total TFL AAC', DECODE(grand.grand_total, 0, 0, reg.muh_aac / grand.grand_total * 100),
              papt.aac_amt)      AS aac_amt,
       reg.reg_ou_code,
       reg.mu_no,
       reg.lic_name,
       reg.aac_effective_date
  FROM aacs papt,
       reg,
       col_names,
       grand
 WHERE papt.mu_id = reg.mu_id
   AND papt.foa_cd = col_names.foa_cd(+)]]>
	</queryString>
