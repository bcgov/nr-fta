	<field name="FOA_DESC_SORT_ORDER" class="java.math.BigDecimal"/>
	<field name="FOA_DESC" class="java.lang.String"/>
	<field name="AAC_AMT" class="java.math.BigDecimal"/>
	<field name="REG_OU_CODE" class="java.lang.String"/>
	<field name="MU_NO" class="java.lang.String"/>
	<field name="LIC_NAME" class="java.lang.String"/>
	<field name="AAC_EFFECTIVE_DATE" class="java.sql.Timestamp"/>
