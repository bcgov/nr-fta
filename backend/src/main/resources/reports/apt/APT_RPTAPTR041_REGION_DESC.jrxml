	<!-- Was THE.APT_RPTAPTR041_REGION_DESC; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[SELECT org_unit_code,
       org_unit_name
  FROM the.org_unit
 WHERE org_unit_code LIKE 'R__' AND expiry_date > SYSDATE
 ORDER BY 1]]>
	</queryString>
	<field name="ORG_UNIT_CODE" class="java.lang.String"/>
	<field name="ORG_UNIT_NAME" class="java.lang.String"/>
