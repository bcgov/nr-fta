	<!-- Was THE.APT_RPTAPTR017; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[-- The procedure fetched the grand totals into variables first (same FROM/WHERE as the result),
-- defaulted them to 0, then divided each row by them; here they are analytic sums over the rows.
WITH
     munv AS ( -- APT_MGMT_UNIT_NAMES_V
       SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                   AS apt_mgmt_unit_st,
              clt.code_argument     AS mgmt_unit_number,
              clt.expanded_result   AS mgmt_unit_name
         FROM the.code_list_table clt
        WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
       UNION
       SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
              NULL,
              clt2.expanded_result
         FROM the.code_list_table clt2
        WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
          AND clt2.code_argument = 'Z')
SELECT RTRIM(region_ou.org_unit_name)   AS region_name,
       munv.mgmt_unit_name              AS tsa_mgmt_unit_name,
       muh.effective_date               AS effective_date,
       muh.allowable_annual_cut         AS aac_m3,
       DECODE(NVL(SUM(muh.allowable_annual_cut) OVER (), 0), 0, 0,
              muh.allowable_annual_cut / SUM(muh.allowable_annual_cut) OVER () * 100)
                                        AS percent_aac_m3,
       muh.allowable_annual_cut_ha      AS aac_ha,
       DECODE(NVL(SUM(muh.allowable_annual_cut_ha) OVER (), 0), 0, 0,
              muh.allowable_annual_cut_ha / SUM(muh.allowable_annual_cut_ha) OVER () * 100)
                                        AS percent_aac_ha
  FROM the.apt_management_units  mu,
       the.apt_mgmt_unit_history muh,
       the.org_unit              district_ou,
       the.org_unit              region_ou,
       munv
 WHERE munv.apt_mgmt_unit_st = mu.apt_mgmt_unit_st
   AND munv.mgmt_unit_number = mu.mgmt_unit_number
   AND mu.mgmt_unit_status_st = 'ACT'
   AND district_ou.org_unit_no = mu.org_unit_no
   AND region_ou.org_unit_code = district_ou.rollup_region_code
   AND munv.apt_mgmt_unit_st = 'U'
   AND mu.id = muh.mu_id
   AND TO_CHAR(muh.effective_date, 'YYYYMMDD')
       || TO_CHAR(NVL(muh.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD') =
       (SELECT MAX(TO_CHAR(h.effective_date, 'YYYYMMDD')
                   || TO_CHAR(NVL(h.apportionment_effective_date, TO_DATE('29991231', 'YYYYMMDD')), 'YYYYMMDD'))
          FROM the.apt_mgmt_unit_history h
         WHERE h.mu_id = mu.id
           AND h.effective_date <= SYSDATE
           AND NVL(h.apportionment_effective_date, TO_DATE('1900', 'YYYY')) <= SYSDATE)
 ORDER BY region_ou.org_unit_name,
          munv.mgmt_unit_name]]>
	</queryString>
