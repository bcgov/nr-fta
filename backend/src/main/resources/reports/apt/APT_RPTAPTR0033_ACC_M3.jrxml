<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR0033_ACC_M3" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ed88a059-75bb-4d23-b630-bab5c08ae602">
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR033_AAC_M3; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[    SELECT cuts_m3.ab_apt_mgmt_unit_st                     apt_mgmt_unit,
           regions_m3.aa_org_unit_code || ' (m3)'          org_unit_label,
           cuts_m3.sum_aac                                 sum_aac
      FROM ( -- cuts_m3 is the first inline view for the first query
            -- Retrieves the numbers for the body of the crosstab.
            SELECT decode(mu.apt_mgmt_unit_st,
                           'U',
                           'Timber Supply Areas (TSA)',
                           'T',
                           'Tree Farm Licences (TFL)')         ab_apt_mgmt_unit_st,
                    mu.org_unit_no mu_org_unit_no,
                    SUM(muh.allowable_annual_cut)            sum_aac
              FROM the.apt_management_units  mu,
                    the.apt_mgmt_unit_history muh
             WHERE  (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) AND --RY U42
                   mu.apt_mgmt_unit_st IN ('T', 'U') AND
                   mu.id = muh.mu_id AND
                   to_char(muh.effective_date,
                           'YYYYMMDD') ||
                   to_char(nvl(muh.apportionment_effective_date,
                               to_date('29991231',
                                       'YYYYMMDD')),
                           'YYYYMMDD') =
                   (SELECT MAX(to_char(effective_date,
                                       'YYYYMMDD') ||
                               to_char(nvl(apportionment_effective_date,
                                           to_date('29991231',
                                                   'YYYYMMDD')),
                                       'YYYYMMDD'))
                      FROM the.apt_mgmt_unit_history muh
                     WHERE mu_id = mu.id AND effective_date <= SYSDATE AND
                           nvl(apportionment_effective_date,
                               to_date('1900',
                                       'YYYY')) <= SYSDATE)
             GROUP BY decode(mu.apt_mgmt_unit_st,
                              'U',
                              'Timber Supply Areas (TSA)',
                              'T',
                              'Tree Farm Licences (TFL)'),
                       mu.org_unit_no) cuts_m3,
           ( -- regions_m3 is the second inline view for the first query.
            -- It retrieves the org unit codes and makes labels out of them.
            SELECT ou.org_unit_code aa_org_unit_code,
                    ou.org_unit_no   org_unit_no
              FROM the.org_unit ou
             WHERE ou.org_unit_code LIKE 'R__' AND
                   effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
                   expiry_date >= CAST($P{p_in_rpt_date} AS DATE)) regions_m3
     WHERE cuts_m3.mu_org_unit_no = regions_m3.org_unit_no]]>
	</queryString>
	<field name="APT_MGMT_UNIT" class="java.lang.String"/>
	<field name="ORG_UNIT_LABEL" class="java.lang.String"/>
	<field name="SUM_AAC" class="java.math.BigDecimal"/>
	<filterExpression><![CDATA[$F{SUM_AAC} != null && $F{SUM_AAC}.doubleValue() > 0.0]]></filterExpression>
