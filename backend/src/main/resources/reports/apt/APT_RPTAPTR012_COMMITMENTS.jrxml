				<measure name="VOLUMEMeasure" class="java.math.BigDecimal" calculation="Sum">
					<measureExpression><![CDATA[$F{VOLUME}]]></measureExpression>
				</measure>
				<crosstabCell width="65" height="11">
					<cellContents>
						<textField isStretchWithOverflow="true" pattern="#,##0" isBlankWhenNull="true">
							<reportElement uuid="8ad85e2f-ef07-469b-8cd0-91f54b41a731" style="Crosstab Data Text" x="0" y="0" width="65" height="11" isRemoveLineWhenBlank="true">
								<printWhenExpression><![CDATA[$V{VOLUMEMeasure_FOA_DESCRIPTION_PARTITION_CODE_ALL} != null && $V{VOLUMEMeasure_FOA_DESCRIPTION_PARTITION_CODE_ALL}.doubleValue() > 0.0]]></printWhenExpression>
							</reportElement>
							<textElement textAlignment="Right" verticalAlignment="Middle">
								<font fontName="DejaVu Sans" size="8"/>
							</textElement>
