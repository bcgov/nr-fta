						<bucketExpression><![CDATA[$F{PARTITION_DESCRIPTION}]]></bucketExpression>
					</bucket>
					<crosstabColumnHeader>
						<cellContents>
							<textField isStretchWithOverflow="true" isBlankWhenNull="true">
								<reportElement uuid="e7a9f207-2ce4-4363-9b83-f6ea31798964" style="Crosstab Data Text" x="0" y="0" width="65" height="11"/>
								<textElement textAlignment="Right" verticalAlignment="Middle">
									<font fontName="DejaVu Sans" size="8"/>
								</textElement>
