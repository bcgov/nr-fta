	<!-- Was THE.APT_RPTAPTR011_HEADER; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[WITH prm AS (
  SELECT CAST($P{in_rpt_date} AS DATE) AS rpt_date,
         $P{IN_MGMT_UNIT_ID}           AS mu_id
    FROM dual
),
-- APT_RPT_APTR011_MU_HISTORY_GET: the latest effective date (with an apportionment effective
-- date) on or before the report date, then the latest apportionment effective date among the
-- rows with that effective date, then that row; NULL unless exactly one row matches (the
-- function returned NULL on NO_DATA_FOUND / TOO_MANY_ROWS).
muh_eff AS (
  SELECT MAX(h.effective_date) AS effective_date
    FROM the.apt_mgmt_unit_history h, prm
   WHERE h.effective_date <= prm.rpt_date
     AND h.apportionment_effective_date <= prm.rpt_date
     AND h.mu_id = prm.mu_id
),
muh_apt AS (
  SELECT MAX(h.apportionment_effective_date) AS apportionment_effective_date
    FROM the.apt_mgmt_unit_history h, muh_eff, prm
   WHERE h.effective_date = muh_eff.effective_date
     AND h.mu_id = prm.mu_id
),
muh_pick AS (
  SELECT CASE WHEN COUNT(*) = 1 THEN MAX(h.id) END AS id
    FROM the.apt_mgmt_unit_history h, muh_eff, muh_apt, prm
   WHERE h.effective_date = muh_eff.effective_date
     AND h.apportionment_effective_date = muh_apt.apportionment_effective_date
     AND h.mu_id = prm.mu_id
)
SELECT prm.rpt_date                       AS rpt_date,
       munv.mgmt_unit_name                AS mgmt_unit_name,
       mu.mgmt_unit_number                AS mgmt_unit_number,
       muh.id                             AS muh_id,
       ou.org_unit_name                   AS region,
       muh.effective_date                 AS effective_date,
       muh.determination_date             AS determination_date,
       muh.apportionment_effective_date   AS apportionment_effective_date,
       muh.apportionment_determination_dt AS apportionment_determination_dt,
       muh.allowable_annual_cut           AS allowable_annual_cut
  FROM the.apt_management_units mu,
       (SELECT DECODE(clt.column_name, 'TFL_NUMBER', 'T', 'TSA_NUMBER', 'U', 'WL_NUMBER', 'F')
                                     AS apt_mgmt_unit_st,
               clt.code_argument     AS mgmt_unit_number,
               clt.expanded_result   AS mgmt_unit_name
          FROM the.code_list_table clt
         WHERE clt.column_name IN ('TFL_NUMBER', 'TSA_NUMBER', 'WL_NUMBER')
        UNION
        SELECT DECODE(clt2.column_name, 'MGMT_UNIT_TYPE', 'Z'),
               NULL,
               clt2.expanded_result
          FROM the.code_list_table clt2
         WHERE clt2.column_name = 'MGMT_UNIT_TYPE'
           AND clt2.code_argument = 'Z') munv,
       the.org_unit ou,
       the.apt_mgmt_unit_history muh,
       muh_pick,
       prm
 WHERE mu.apt_mgmt_unit_st = munv.apt_mgmt_unit_st
   AND mu.org_unit_no = ou.org_unit_no
   AND mu.mgmt_unit_number = munv.mgmt_unit_number
   AND mu.id = muh.mu_id
   AND (mu.mgmt_unit_status_st = 'ACT' OR mu.status_effective_date > prm.rpt_date)
   AND muh.id = muh_pick.id
   AND mu.id = prm.mu_id]]>
	</queryString>
