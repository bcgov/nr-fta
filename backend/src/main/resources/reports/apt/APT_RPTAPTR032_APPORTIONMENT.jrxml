<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR032_APPORTIONMENT" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="305a223b-0ebe-4ff0-9236-e66f0ff2002e">
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR032_APPORTIONMENT; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[WITH aac_rows AS ( -- the rows of the AAC subreport (section A)
SELECT decode(mu.apt_mgmt_unit_st,
              'U',
              1,
              'T',
              2) sort_order --, 'F', 2) #2
      ,
       decode(mu.apt_mgmt_unit_st,
              'U',
              'Timber Supply Area (TSA)',
              'T',
              'Tree Farm Licences (TFL)') apt_mgmt_unit_st --, 'F', 'WL' #2
      ,
       SUM(muh.allowable_annual_cut)    sum_aac,
       SUM(muh.allowable_annual_cut_ha)    sum_aac_ha
  FROM the.apt_management_units  mu,
       the.apt_mgmt_unit_history muh
 WHERE (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) --RY U42 --#1
       AND mu.apt_mgmt_unit_st IN ('T', 'U') --, 'F' #2
       AND mu.id = muh.mu_id AND
       to_char(muh.effective_date,
               'YYYYMMDD') ||
       to_char(nvl(muh.apportionment_effective_date,
                   to_date('29991231',
                           'YYYYMMDD')),
               'YYYYMMDD') =
       (SELECT MAX(to_char(effective_date,
                           'YYYYMMDD') ||
                   to_char(nvl(apportionment_effective_date,
                               to_date('29991231',
                                       'YYYYMMDD')),
                           'YYYYMMDD'))
          FROM the.apt_mgmt_unit_history muh
         WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
               nvl(apportionment_effective_date,
                   to_date('1900',
                           'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE))
 GROUP BY decode(mu.apt_mgmt_unit_st,
                 'U',
                 1,
                 'T',
                 2) --, 'F', 2 #2
         ,
          decode(mu.apt_mgmt_unit_st,
                 'U',
                 'Timber Supply Area (TSA)',
                 'T',
                 'Tree Farm Licences (TFL)')
),
aac_totals AS ( -- the PL/SQL loop: 0 plus each row sum, so one NULL row sum makes the total NULL
SELECT CASE WHEN COUNT(sum_aac) = COUNT(*) THEN NVL(SUM(sum_aac), 0) END sum_aac_m3_total,
       CASE WHEN COUNT(sum_aac_ha) = COUNT(*) THEN NVL(SUM(sum_aac_ha), 0) END sum_aac_ha_total
  FROM aac_rows
)
        SELECT decode(mu.apt_mgmt_unit_st,
                      'T',
                      'TFL')                mgmt_unit_type_cd, --'F', 'WL' #2*
               aftvb.expanded_result foa_description,
               aftvb.sort_order      sort_order,
               SUM(paptb.allowable_annual_cut)                   aac_m3_sum,
               decode(aac_totals.sum_aac_m3_total,
                      0,
                      to_number(NULL),
                      SUM(paptb.allowable_annual_cut) / aac_totals.sum_aac_m3_total * 100)                percent_aac_m3_sum,
               SUM(paptb.allowable_annual_cut_ha)                   aac_ha_sum,
               decode(aac_totals.sum_aac_ha_total,
                      0,
                      to_number(NULL),
                      SUM(paptb.allowable_annual_cut_ha) /
                      aac_totals.sum_aac_ha_total * 100)                percent_aac_ha_sum
          FROM the.apt_management_units    mu,
               the.apt_mgmt_unit_history   muh,
               the.apt_partitions          partb,
               (SELECT clt.code_argument part_type_cd, clt.expanded_result part_type_desc FROM the.code_list_table clt, the.code_subset_tbl cst WHERE cst.code_subset_name = 'APT_PART_RPT_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument)          aprvb,
               the.apt_part_apportionments paptb,
               (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)         aftvb,
               aac_totals
         WHERE mu.mgmt_unit_status_st = 'ACT' --#1
               AND mu.apt_mgmt_unit_st = 'T' -- IN ('T', 'F') #2
               AND aftvb.apt_mgmt_unit_st = 'T' AND
               aftvb.expiry_date > CAST($P{p_in_rpt_date} AS DATE) AND mu.id = muh.mu_id AND
               to_char(muh.effective_date,
                       'YYYYMMDD') ||
               to_char(nvl(muh.apportionment_effective_date,
                           to_date('29991231',
                                   'YYYYMMDD')),
                       'YYYYMMDD') =
               (SELECT MAX(to_char(effective_date,
                                   'YYYYMMDD') ||
                           to_char(nvl(apportionment_effective_date,
                                       to_date('29991231',
                                               'YYYYMMDD')),
                                   'YYYYMMDD'))
                  FROM the.apt_mgmt_unit_history
                 WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
                       nvl(apportionment_effective_date,
                           to_date('1900',
                                   'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE)) AND
               partb.muh_id = muh.id AND
               partb.apt_partition_st = aprvb.part_type_cd AND
               paptb.part_id = partb.id AND
               aftvb.code_argument = paptb.apt_foa_st AND
               aftvb.apt_mgmt_unit_st = mu.apt_mgmt_unit_st
         GROUP BY decode(mu.apt_mgmt_unit_st,
                         'T',
                         'TFL'), --'F', 'WL' #2
                  aftvb.sort_order,
                  aftvb.expanded_result,
                  aac_totals.sum_aac_m3_total,
                  aac_totals.sum_aac_ha_total
        UNION
            SELECT decode(mu.apt_mgmt_unit_st,
                          'U',
                          'TSA')                mgmt_unit_type_cd,
                   aftvb.expanded_result foa_description,
                   aftvb.sort_order      sort_order,
                   SUM(paptb.allowable_annual_cut)                   aac_m3_sum,
                   decode(aac_totals.sum_aac_m3_total,
                          0,
                          to_number(NULL),
                          SUM(paptb.allowable_annual_cut) /
                          aac_totals.sum_aac_m3_total * 100)                percent_aac_m3_sum,
                   SUM(paptb.allowable_annual_cut_ha)                   aac_ha_sum,
                   decode(aac_totals.sum_aac_ha_total,
                          0,
                          to_number(NULL),
                          SUM(paptb.allowable_annual_cut_ha) /
                          aac_totals.sum_aac_ha_total * 100)                percent_ha_sum
              FROM the.apt_management_units    mu,
                   the.apt_mgmt_unit_history   muh,
                   the.apt_partitions          partb,
                   the.apt_part_apportionments paptb,
                   (SELECT clt.code_argument part_type_cd, clt.expanded_result part_type_desc FROM the.code_list_table clt, the.code_subset_tbl cst WHERE cst.code_subset_name = 'APT_PART_RPT_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument)          aprvb,
                   (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)         aftvb,
               aac_totals
             WHERE mu.mgmt_unit_status_st = 'ACT' --#1
                   AND mu.apt_mgmt_unit_st = 'U' AND
                   aftvb.apt_mgmt_unit_st = 'U' AND
                   aftvb.expiry_date > CAST($P{p_in_rpt_date} AS DATE) AND mu.id = muh.mu_id AND
                   to_char(muh.effective_date,
                           'YYYYMMDD') ||
                   to_char(nvl(muh.apportionment_effective_date,
                               to_date('29991231',
                                       'YYYYMMDD')),
                           'YYYYMMDD') =
                   (SELECT MAX(to_char(effective_date,
                                       'YYYYMMDD') ||
                               to_char(nvl(apportionment_effective_date,
                                           to_date('29991231',
                                                   'YYYYMMDD')),
                                       'YYYYMMDD'))
                      FROM the.apt_mgmt_unit_history
                     WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
                           nvl(apportionment_effective_date,
                               to_date('1900',
                                       'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE)) AND
                   partb.muh_id = muh.id AND
                   partb.apt_partition_st = aprvb.part_type_cd AND
                   paptb.part_id = partb.id AND
                   aftvb.code_argument = paptb.apt_foa_st AND
                   aftvb.apt_mgmt_unit_st = mu.apt_mgmt_unit_st
             GROUP BY decode(mu.apt_mgmt_unit_st,
                             'U',
                             'TSA'),
                      aftvb.sort_order,
                      aftvb.expanded_result,
                      aac_totals.sum_aac_m3_total,
                      aac_totals.sum_aac_ha_total
             ORDER BY mgmt_unit_type_cd DESC,
                      sort_order]]>
	</queryString>
