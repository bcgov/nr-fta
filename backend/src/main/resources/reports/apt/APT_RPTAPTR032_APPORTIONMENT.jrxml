	</variable>
	<variable name="grand_total_PERCENT_AAC_M3_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PERCENT_AAC_M3_SUM}]]></variableExpression>
	</variable>
	<variable name="grand_total_AAC_HA_SUM" class="java.math.BigDecimal" calculation="Sum">
