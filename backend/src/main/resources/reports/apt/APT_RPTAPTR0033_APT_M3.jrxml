<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="APT_RPTAPTR0033_APT_M3" pageWidth="752" pageHeight="572" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7d82b29e-8edd-422a-9dd0-7a34eae3c7df">
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="p_in_rpt_date" class="java.util.Date"/>
	<!-- Was THE.APT_RPTAPTR033_APT_M3; the same query on the tables (no EXECUTE grant needed). -->
	<queryString language="sql">
		<![CDATA[       SELECT decode(foa_body_m3.bb_apt_mgmt_unit_st,
                     'TFL',
                     'B',
                     'TSA',
                     'A',
                     foa_body_m3.bb_apt_mgmt_unit_st) apt_mu_sort_order,
              foa_body_m3.bb_apt_mgmt_unit_st apt_mgmt_unit,
              foa_body_m3.expanded_result foa_description,
              foa_body_m3.sort_order foa_sort_order,
              foa_body_m3.paptb_aac sum_aac,
              regions_m3.aa_org_unit_code || ' (m3)' org_unit_code,
              CASE WHEN (SELECT SUM(paptb.allowable_annual_cut_ha) paptb_aac_ha
 FROM the.apt_management_units    mu,
      the.apt_mgmt_unit_history   muh,
      the.apt_partitions          partb,
      (SELECT clt.code_argument part_type_cd, clt.expanded_result part_type_desc FROM the.code_list_table clt, the.code_subset_tbl cst WHERE cst.code_subset_name = 'APT_PART_RPT_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument)          aprvb,
      the.apt_part_apportionments paptb,
      (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)         aftvb
WHERE (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) AND --RY U42
      mu.apt_mgmt_unit_st IN ('U', 'T') AND mu.id = muh.mu_id AND
      to_char(muh.effective_date,
              'YYYYMMDD') ||
      to_char(nvl(muh.apportionment_effective_date,
                  to_date('29991231',
                          'YYYYMMDD')),
              'YYYYMMDD') =
      (SELECT MAX(to_char(effective_date,
                          'YYYYMMDD') ||
                  to_char(nvl(apportionment_effective_date,
                              to_date('29991231',
                                      'YYYYMMDD')),
                          'YYYYMMDD'))
         FROM the.apt_mgmt_unit_history
        WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
              nvl(apportionment_effective_date,
                  to_date('1900',
                          'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE)) AND
      partb.muh_id = muh.id AND
      partb.apt_partition_st = aprvb.part_type_cd AND
      paptb.part_id = partb.id AND
      aftvb.code_argument = paptb.apt_foa_st AND
      aftvb.apt_mgmt_unit_st = mu.apt_mgmt_unit_st) IS NULL THEN 'HIDE HA' ELSE 'SHOW HA' END ha_status
         FROM (-- foa_body_m3
               -- get the bulk of the report data
               SELECT DISTINCT decode(mu.apt_mgmt_unit_st,
                                      'U',
                                      'TSA',
                                      'T',
                                      'TFL') bb_apt_mgmt_unit_st,
                               aftvb.expanded_result,
                               aftvb.sort_order sort_order,
                               mu.org_unit_no,
                               SUM(paptb.allowable_annual_cut) paptb_aac
                 FROM the.apt_management_units    mu,
                      the.apt_mgmt_unit_history   muh,
                      the.apt_partitions          partb,
                      (SELECT clt.code_argument part_type_cd, clt.expanded_result part_type_desc FROM the.code_list_table clt, the.code_subset_tbl cst WHERE cst.code_subset_name = 'APT_PART_RPT_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument)          aprvb,
                      the.apt_part_apportionments paptb,
                      (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)         aftvb
                WHERE (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) AND --RY U42
                      mu.apt_mgmt_unit_st IN ('U', 'T') AND
                      mu.id = muh.mu_id AND
                      to_char(muh.effective_date,
                              'YYYYMMDD') ||
                      to_char(nvl(muh.apportionment_effective_date,
                                  to_date('29991231',
                                          'YYYYMMDD')),
                              'YYYYMMDD') =
                      (SELECT MAX(to_char(effective_date,
                                          'YYYYMMDD') ||
                                  to_char(nvl(apportionment_effective_date,
                                              to_date('29991231',
                                                      'YYYYMMDD')),
                                          'YYYYMMDD'))
                         FROM the.apt_mgmt_unit_history
                        WHERE mu_id = mu.id AND effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND
                              nvl(apportionment_effective_date,
                                  to_date('1900',
                                          'YYYY')) <= CAST($P{p_in_rpt_date} AS DATE)) AND
                      partb.muh_id = muh.id AND
                      partb.apt_partition_st = aprvb.part_type_cd AND
                      paptb.part_id = partb.id AND
                      aftvb.code_argument = paptb.apt_foa_st AND
                      aftvb.apt_mgmt_unit_st = mu.apt_mgmt_unit_st
                GROUP BY decode(mu.apt_mgmt_unit_st,
                                'U',
                                'TSA',
                                'T',
                                'TFL'),
                         aftvb.sort_order,
                         aftvb.expanded_result,
                         mu.org_unit_no) foa_body_m3,
              (-- foa_labels
               -- Selects which foa labels to display since foa_body_m3
               -- returns too many.
               SELECT DISTINCT decode(mu.apt_mgmt_unit_st,
                                      'U',
                                      'TSA',
                                      'T',
                                      'TFL') b1_apt_mgmt_unit_st,
                               aftvb.expanded_result,
                               aftvb.sort_order sort_order
                 FROM the.apt_management_units    mu,
                      the.apt_mgmt_unit_history   muh,
                      the.apt_partitions          partb,
                      the.apt_part_apportionments paptb,
                      (SELECT clt.code_argument, clt.expanded_result, clt.effective_date, clt.expiry_date, acat.apt_mgmt_unit_st, acat.sort_order FROM the.code_list_table clt, the.code_subset_tbl cst, the.apt_apportionment_categories acat WHERE cst.code_subset_name = 'APT_FOA_ST' AND clt.column_name = cst.column_name AND clt.code_argument = cst.code_argument AND acat.apt_foa_st = clt.code_argument)         aftvb
                WHERE (mu.mgmt_unit_status_st = 'ACT' or mu.status_effective_date > CAST($P{p_in_rpt_date} AS DATE)) AND --RY U42
                      mu.apt_mgmt_unit_st IN ('U', 'T') --= 'U'
                      AND mu.id = muh.mu_id AND partb.muh_id = muh.id AND
                      paptb.part_id = partb.id AND
                      aftvb.code_argument = paptb.apt_foa_st AND
                      aftvb.apt_mgmt_unit_st = mu.apt_mgmt_unit_st AND
                      aftvb.expiry_date > CAST($P{p_in_rpt_date} AS DATE)
                GROUP BY decode(mu.apt_mgmt_unit_st,
                                'U',
                                'TSA',
                                'T',
                                'TFL'),
                         aftvb.sort_order,
                         aftvb.expanded_result) foa_labels,
              ( -- regions_m3
               -- Get the org unit codes for use in the column headings.
               SELECT ou.org_unit_code aa_org_unit_code,
                       ou.org_unit_no   org_unit_no
                 FROM the.org_unit ou
                WHERE ou.org_unit_code LIKE 'R__' AND
                      effective_date <= CAST($P{p_in_rpt_date} AS DATE) AND expiry_date >= CAST($P{p_in_rpt_date} AS DATE)) regions_m3
        WHERE foa_body_m3.org_unit_no = regions_m3.org_unit_no AND
              foa_body_m3.bb_apt_mgmt_unit_st(+) =
              foa_labels.b1_apt_mgmt_unit_st AND
              foa_body_m3.expanded_result(+) = foa_labels.expanded_result AND
              foa_body_m3.sort_order(+) = foa_labels.sort_order]]>
	</queryString>
