		<variableExpression><![CDATA[($F{reverse_charge_ind}.equals( "N" )) ? ($F{rent}.doubleValue() + $F{fee}.doubleValue() + $F{issue_fee}.doubleValue()) * ((double)1.0 + ($F{total_incl_tax}.doubleValue())/(double)100.0)
